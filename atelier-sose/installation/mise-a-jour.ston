				#source : 'speedColorFor: id\r    | ratio |\r    self droneColorMode = #speed ifFalse: [ ^ Color white ].\r    ratio := speedRatios at: id ifAbsent: [ 1 ].\r    ratio < 0.95 ifTrue: [ ^ Color fromHexString: \'62C6FF\' ].\r    ratio > 1.05 ifTrue: [ ^ Color fromHexString: \'FFAE68\' ].\r    ^ Color white\r',
