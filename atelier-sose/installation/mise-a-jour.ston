			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'relief: source epsg: epsg\r\r\t| resultat dx dy largeur hauteur |\r\tdx := grille third.\r\tdy := grille fourth.\r\tlargeur := grille fifth.\r\thauteur := grille sixth.\r\tresultat := Array new: hauteur.\r\t0 to: hauteur - 1 by: 640 do: [ :y |\r\t\t\t| lignes |\r\t\t\tlignes := 640 min: hauteur - y.\r\t\t\t1 to: lignes do: [ :j |\r\t\t\tresultat at: y + j put: (Float32Array new: largeur) ].\r\t\t\t0 to: largeur - 1 by: 640 do: [ :x |\r\t\t\t\t\t| colonnes tuile valeurs |\r\t\t\t\t\tcolonnes := 640 min: largeur - x.\r\t\t\t\t\ttuile := {\r\t\t\t\t\t\t         (grille first + (x * dx)).\r\t\t\t\t\t\t         (grille second - (y * dy)).\r\t\t\t\t\t\t         dx.\r\t\t\t\t\t\t         dy.\r\t\t\t\t\t\t         colonnes.\r\t\t\t\t\t\t         lignes }.\r\t\t\t\t\tvaleurs := self tuile: tuile fournisseur: source epsg: epsg.\r\t\t\t\t\t1 to: lignes do: [ :j |\r\t\t\t\t\t\t\t(resultat at: y + j)\r\t\t\t\t\t\t\t\treplaceFrom: x + 1\r\t\t\t\t\t\t\t\tto: x + colonnes\r\t\t\t\t\t\t\t\twith: (valeurs at: j)\r\t\t\t\t\t\t\t\tstartingAt: 1 ] ] ].\r\t^ resultat',
