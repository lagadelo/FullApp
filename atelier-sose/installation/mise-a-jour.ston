		[
			#SoSeVercorsExample
		] : OrderedCollection [
			MCClassDefinition {
				#name : #SoSeVercorsExample,
				#superclassName : #Object,
				#variables : OrderedCollection [
					MCInstanceVariableDefinition {
						#name : 'replay'
					}
				],
				#packageName : #DroneSystem-Macro,
				#type : #normal,
				#comment : 'Exemple de SoSe sur la boucle du Vercors avec observation hybride des voisins et rendu des relevés du MNT. Charger reprise-distances.st pour partager les sommets projetés en mètres entre la commande et le rejeu.\r\rexample := SoSeVercorsExample vercorsFrom: bundle / \'rejeu-vercors\'.\rsimulator := example simulate.\rexample replay playHistory: simulator history every: 5.\rexample export: simulator every: 5 into: output.\r\rLe scénario fait disparaître d’abord la mesure de distance, puis le gisement. Avec les lois à deux écarts, un drone qui ne dispose plus de deux valeurs exploitables garde sa dernière vitesse. Lorsque les écarts redeviennent exploitables, la loi s’applique au tik courant. Le rendu optique du MNT lit l’historique et possède sa propre configuration.\r',
				#commentStamp : 'SoSe',
				#tagName : #Replay,
				#traitComposition : '{}',
				#classTraitComposition : '{}'
			}
		],
		[
			#PerceptionMissionView,
			#'speedColorFor:',
			false
		] : OrderedCollection [
			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'speedColorFor: id\r    | ratio |\r    (options at: #showSpeedColors ifAbsent: [ false ]) ifFalse: [ ^ Color white ].\r    ratio := speedRatios at: id ifAbsent: [ 1 ].\r    ratio < 0.95 ifTrue: [ ^ Color fromHexString: \'62C6FF\' ].\r    ratio > 1.05 ifTrue: [ ^ Color fromHexString: \'FFAE68\' ].\r    ^ Color white\r',
				#category : #drawing,
				#selector : #'speedColorFor:',
				#className : #PerceptionMissionView,
				#timeStamp : ''
			},
