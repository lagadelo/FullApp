				#source : 'newSimulatorWith: configure\r    "Les vitesses du bloc sont en m/s et les portées sont en mètres."\r    | simulator points |\r    points := replay projectedWayPoints.\r    points asSet size >= 3\r        ifFalse: [ self error: \'Le parcours hybride exige au moins trois sommets distincts.\' ].\r    simulator := replay newSimulatorWith: [ :parameters |\r        parameters\r            wayPoints: points;\r            numberOfDrones: 20;\r            minSpeed: 5;\r            nominalSpeed: 10;\r            maxSpeed: 15;\r            sensingRadius: 1600;\r            captureRadius: 90;\r            policy: #revisedCapingPolicy.\r        configure value: parameters ].\r    simulator perceptionModel: MacroSimulatorHybridPerception new.\r    simulator behavior sensibility: 0.01; pacingRate: 0.9.\r    ^ simulator\r',
