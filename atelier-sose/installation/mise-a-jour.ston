				#source : 'newSimulatorWith: configure\r    | parameters minSpeed nominalSpeed maxSpeed |\r    parameters := MacroSimulatorParameters new\r        numberOfDrones: 20;\r        totalDistance: self perimeterMeters;\r        minSpeed: 5;\r        nominalSpeed: 10;\r        maxSpeed: 15;\r        sensingRadius: 20;\r        captureRadius: 20;\r        policy: #capingPolicy;\r        seed: 3950149054165;\r        yourself.\r    configure value: parameters.\r    (parameters numberOfDrones isInteger and: [ parameters numberOfDrones > 0 ])\r        ifFalse: [ self error: \'L’effectif doit être un entier positif.\' ].\r    minSpeed := parameters minSpeed.\r    nominalSpeed := parameters nominalSpeed.\r    maxSpeed := parameters maxSpeed.\r    (({ minSpeed. nominalSpeed. maxSpeed } allSatisfy: [ :speed | speed isNumber and: [ speed asFloat isFinite ] ])\r        and: [ minSpeed >= 0 and: [ nominalSpeed > 0 and: [\r            minSpeed <= nominalSpeed and: [ nominalSpeed <= maxSpeed ] ] ] ])\r                ifFalse: [ self error: \'Les vitesses doivent respecter 0 ≤ min ≤ nominale ≤ max et nominale > 0.\' ].\r    "MacroSimulatorDrone >> update ajoute la vitesse à l’abscisse à chaque mouvement."\r    parameters\r        minSpeed: minSpeed * secondsPerTick;\r        nominalSpeed: nominalSpeed * secondsPerTick;\r        maxSpeed: maxSpeed * secondsPerTick.\r    ^ parameters initializeSimulator\r',
