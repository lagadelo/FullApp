{
	#definitions : OrderedCollection [
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'soSe\r    "Une exécution de l’expérience SoSe, avec pacingRate 0.9 et sensibilité 0.01."\r    | parameters simulator |\r    parameters := MacroSimulatorParameters new\r        numberOfDrones: 100;\r        nominalSpeed: 10;\r        maxSpeed: 15;\r        sensingRadius: 20;\r        captureRadius: 20;\r        totalDistance: 10000;\r        policy: #capingPolicy;\r        seed: 3950149054165;\r        yourself.\r    simulator := parameters initializeSimulator.\r    simulator behavior sensibility: 0.01; pacingRate: 0.9.\r    simulator loose: 1 at: 200.\r    simulator loose: 30 at: 500.\r    simulator loose: 80 at: 800.\r    simulator newIncomerAt: 500.\r    simulator newIncomerAt: 500.\r    simulator newIncomerAt: 1000.\r    simulator run: 1500.\r    ^ simulator\r',
			#category : #exemples,
			#selector : #soSe,
			#className : #FullAppMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'isSeWithSeedIndex: anIndex\r    | simulator |\r    simulator := MacroSimulatorExample generateScenario: anIndex.\r    simulator run: 1500.\r    ^ simulator\r',
			#category : #exemples,
			#selector : #'isSeWithSeedIndex:',
			#className : #FullAppMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'newSimulatorWith: configure\r    "Les vitesses du bloc sont en m/s et les portées sont en mètres."\r    | simulator points |\r    points := replay projectedWayPoints.\r    points asSet size >= 3\r        ifFalse: [ self error: \'Le parcours hybride exige au moins trois sommets distincts.\' ].\r    simulator := replay newSimulatorWith: [ :parameters |\r        parameters\r            wayPoints: points;\r            numberOfDrones: 20;\r            minSpeed: 5;\r            nominalSpeed: 10;\r            maxSpeed: 15;\r            sensingRadius: 1600;\r            captureRadius: 90;\r            policy: #revisedCapingPolicy.\r        configure value: parameters ].\r    simulator perceptionModel: MacroSimulatorHybridPerception new.\r    simulator behavior sensibility: 0.01; pacingRate: 0.9.\r    ^ simulator\r',
			#category : #simulation,
			#selector : #'newSimulatorWith:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'exportMetricsOf: simulator into: aDirectory\r    | exporter metrics |\r    exporter := MacroSimulatorResultExporter directoryName: aDirectory.\r    metrics := simulator evaluateMetrics.\r    ^ exporter exportHistoryCSV: metrics named: \'sose\'\r        fields: #(timeStep fleetSize maxGap stdGap avgSpeed coverageRatio\r            directPerceptionRatio angularPerceptionRatio unobservablePerceptionRatio\r            outOfRangePerceptionRatio avgGapEstimationError maxGapEstimationError)\r',
			#category : #export,
			#selector : #'exportMetricsOf:into:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'initializeOn: aReplay\r    replay := aReplay.\r    replay secondsPerTick: 2; heightAboveGround: 180.\r    replay displayOptions\r        at: #camera put: { 0.5. 2000 };\r        at: #droneColorMode put: #acceleration;\r        at: #droneMarkerSize put: 5;\r        at: #fadeAfterSeconds put: 40;\r        at: #transparentAfterSeconds put: 75.\r    ^ self\r',
			#category : #configuration,
			#selector : #'initializeOn:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'scheduleOutageOn: simulator\r    "Les événements portent sur le voisinage utilisé par la loi de commande."\r    simulator scheduleAllDistanceMeasurementAvailable: false at: 25.\r    simulator scheduleVisionAvailable: false at: 45 matching: [ :drone | true ].\r    simulator scheduleVisionAvailable: true at: 70 matching: [ :drone | true ].\r    simulator scheduleAllDistanceMeasurementAvailable: true at: 85.\r    simulator current drones size > 1 ifTrue: [\r        simulator loose: simulator current drones first id at: 55.\r        simulator newIncomerAt: 110 ].\r    ^ simulator\r',
			#category : #simulation,
			#selector : #'scheduleOutageOn:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'replay\r    ^ replay\r',
			#category : #configuration,
			#selector : #replay,
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'export: simulator every: stride into: aDirectory\r    "Exporte les métriques à chaque tik et une image tous les stride tiks."\r    | output images |\r    output := aDirectory asFileReference asAbsolute.\r    output parent ensureCreateDirectory.\r    output createDirectory.\r    self exportMetricsOf: simulator into: output.\r    images := replay exportHistory: simulator history every: stride into: output.\r    (output / \'images.txt\') writeStreamDo: [ :stream |\r        stream nextPutAll: images fullName; lf ].\r    ^ output\r',
			#category : #export,
			#selector : #'export:every:into:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'simulate\r    | simulator |\r    simulator := self newSimulatorWith: [ :parameters | ].\r    self scheduleOutageOn: simulator.\r    simulator runSingleUpdate: 140.\r    ^ simulator\r',
			#category : #simulation,
			#selector : #simulate,
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'vercorsFrom: aDirectory\r    ^ self on: (PerceptionMacroReplay vercorsFrom: aDirectory)\r',
			#category : #'instance creation',
			#selector : #'vercorsFrom:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'on: aReplay\r    ^ self new initializeOn: aReplay\r',
			#category : #'instance creation',
			#selector : #'on:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'fromTerrain: aDirectory routeFile: aFile\r    ^ self on: (PerceptionMacroReplay fromTerrain: aDirectory routeFile: aFile)\r',
			#category : #'instance creation',
			#selector : #'fromTerrain:routeFile:',
			#className : #SoSeVercorsExample,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'computeInterWayPointsDistances\r    "Les GeoPoint gardent les kilomètres du profil historique. Un Point est déjà projeté."\r    | points |\r    points := self wayPoints.\r    ^ (1 to: points size) collect: [ :index |\r        | start stop |\r        start := points at: index.\r        stop := points at: (index \\\\ points size) + 1.\r        (self isGeographicPoint: start)\r            ifTrue: [ (self haversineMetersFrom: start to: stop) / 1000 ]\r            ifFalse: [ start distanceTo: stop ] ]\r',
			#category : #'computing - waypoints',
			#selector : #computeInterWayPointsDistances,
			#className : #MacroSimulatorParameters,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example5\r\t"Prospection"\r\r\t| parameters simulator pacingRates sensibilities exporter |\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example5\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.97. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\tparameters := MacroSimulatorParameters new\r\t\t\t\t\t\t              numberOfDrones: 100;\r\t\t\t\t\t\t              nominalSpeed: 10;\r\t\t\t\t\t\t              maxSpeed: 15;\r\t\t\t\t\t\t              minSpeed: 8;\r\t\t\t\t\t\t              sensingRadius: 20;\r\t\t\t\t\t\t              captureRadius: 20;\r\t\t\t\t\t\t              totalDistance: 10000;\r\t\t\t\t\t\t              yourself.\r\t\t\t\t\tparameters policy: #capingPolicy.\r\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\tsimulator loose: 1 at: 200.\r\t\t\t\t\tsimulator run: 1500.\r\t\t\t\t\texporter visit: simulator ] ]',
			#category : #examples,
			#selector : #example5,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.289229+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example7\r\t"Prospection - in/out drone "\r\r\t| parameters simulator pacingRates sensibilities exporter |\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example7\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.97. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 100;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              yourself.\r\tparameters policy: #capingPolicy.\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\tsimulator loose: 1 at: 200.\r\t\t\t\t\tsimulator loose: 30 at: 500.\r\t\t\t\t\tsimulator loose: 10 at: 400.\r\t\t\t\t\tsimulator loose: 20 at: 500.\r\t\t\t\t\tsimulator loose: 57 at: 1200.\r\t\t\t\t\tsimulator loose: 80 at: 800.\r\t\t\t\t\tsimulator newIncomerAt: 550.\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t\tsimulator newIncomerAt: 1000.\r\t\t\t\t\tsimulator run: 3000.\r\t\t\t\t\texporter visit: simulator ] ]',
			#category : #examples,
			#selector : #example7,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.298809+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example10\r\t"Prospection - in/out drone "\r\r\t"revised capingPolicy"\r\r\t" self example10 "\r\r\t| macroMetricsSeries parameters simulator pacingRates sensibilities exporter minSpeeds outputDirectory |\r\tmacroMetricsSeries := MacroSimulatorMetricsSerie new.\r\tmacroMetricsSeries addExtractor: #average -> #stdGap.\r\tmacroMetricsSeries addExtractor: #stabilityRatio -> #maxGap.\r\tmacroMetricsSeries addExtractor: #stabilizationTime -> #maxGap.\r\tmacroMetricsSeries addExtractor: #min -> #maxGap.\r\tmacroMetricsSeries addExtractor: #max -> #maxGap.\r\tmacroMetricsSeries addExtractor: #stabilizationDuration -> #avgSpeed.\r\tmacroMetricsSeries addExtractor: #average -> #avgSpeed.\r\tmacroMetricsSeries parameters: #( pacingRate sensibilities minSpeed ).\r\r\toutputDirectory := self legacyOutputDirectoryFor: \'example10\'.\r\texporter := MacroExporter directoryName: outputDirectory fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.87. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tminSpeeds := { 5. 6. 7. 8. 9. 20 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 100;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              policy: #revisedCapingPolicy;\r\t\t              seed: 3950149054165;\r\t\t              yourself.\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\tminSpeeds do: [ :ms |\r\t\t\t\t\t\t\t| data |\r\t\t\t\t\t\t\tparameters minSpeed: ms.\r\r\t\t\t\t\t\t\tsimulator := parameters initializeSimulator.\r\r\t\t\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\t\t\tsimulator loose: 1 at: 199.\r\t\t\t\t\t\t\t"simulator loose: 30 at: 500.\r\t\t\t\t\tsimulator loose: 80 at: 800.\r\t\t\t\t\tsimulator newIncomerAt: 300.\r\t\t\t\t\tsimulator newIncomerAt: 400.\r\t\t\t\t\tsimulator newIncomerAt: 1000."\r\t\t\t\t\t\t\tsimulator run: 1500.\r\r\r\t\t\t\t\t\t\tdata := (MacroExporter directoryName:\r\t\t\t\t\t\t\t\t(outputDirectory / (\'minSpeed-\', ms printString)) fullName)\r\t\t\t\t\t\t\t\tvisit: simulator.\r\t\t\t\t\t\t\tmacroMetricsSeries addToSeries:\r\t\t\t\t\t\t\t\t(Array with: p with: s with: ms) -> data ")" ] ] ].\r\t^ exporter visit: macroMetricsSeries',
			#category : #examples,
			#selector : #example10,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.306018+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example1\r\t"Simple case - no loss"\r\r\t| parameters simulator |\r\tparameters := MacroSimulatorParameters example1.\r\tsimulator := parameters initializeSimulator.\r\tsimulator run: 50.\r\t^ simulator inspect',
			#category : #examples,
			#selector : #example1,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.285707+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example9\r\t"Prospection - in/out drone "\r\r\t"revised capingPolicy"\r\r\t" self example9"\r\r\t| macroMetricsSeries parameters simulator pacingRates sensibilities exporter |\r\tmacroMetricsSeries := MacroSimulatorMetricsSerie new.\r\tmacroMetricsSeries addExtractor: #average -> #stdGap.\r\tmacroMetricsSeries addExtractor: #stabilityRatio -> #maxGap.\r\tmacroMetricsSeries addExtractor: #stabilizationTime -> #maxGap.\r\r\tmacroMetricsSeries addExtractor: #stabilizationDuration -> #avgSpeed.\r\tmacroMetricsSeries addExtractor: #average -> #avgSpeed.\r\tmacroMetricsSeries parameters: #( pacingRate sensibilities ).\r\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example9\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 100;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              policy: #revisedCapingPolicy;\r\t\t              seed: 3950149054165;\r\t\t              yourself.\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\t| data |\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\tsimulator loose: 1 at: 200.\r\t\t\t\t\tsimulator loose: 30 at: 500.\r\t\t\t\t\tsimulator loose: 80 at: 800.\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t\tsimulator newIncomerAt: 1000.\r\t\t\t\t\tsimulator run: 1500.\r\r\r\t\t\t\t\tdata := exporter visit: simulator.\r\t\t\t\t\tmacroMetricsSeries addToSeries: (Array with: p with: s) -> data ")" ] ].\r\t^ exporter visit: macroMetricsSeries',
			#category : #examples,
			#selector : #example9,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.302966+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example8b\r\t"Idem example8 plus complex extractor "\r\r\t" self example8b"\r\r\t| macroMetricsSeries parameters simulator pacingRates sensibilities exporter |\r\tmacroMetricsSeries := MacroSimulatorMetricsSerie new.\r\tmacroMetricsSeries addExtractor: (MacroSimulatorExtractor\r\t\tlabel: \'average(stdGap)\'\r\t\tblock: [ :metrics | (metrics collect: #stdGap) average ]).\r\tmacroMetricsSeries addExtractor: #stabilityRatio -> #maxGap.\r\tmacroMetricsSeries addExtractor: #stabilizationTime -> #maxGap.\r\r\tmacroMetricsSeries addExtractor: #stabilizationDuration -> #avgSpeed.\r\tmacroMetricsSeries addExtractor: #average -> #avgSpeed.\r\tmacroMetricsSeries parameters: #( pacingRate sensibilities ).\r\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example8b\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.87. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 100;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              policy: #capingPolicy;\r\t\t              seed: 3950149054165;\r\t\t              yourself.\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\t| data |\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\tsimulator loose: 1 at: 200.\r\t\t\t\t\tsimulator loose: 30 at: 500.\r\t\t\t\t\tsimulator loose: 80 at: 800.\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t\tsimulator newIncomerAt: 1000.\r\t\t\t\t\tsimulator run: 1500.\r\r\r\t\t\t\t\tdata := exporter visit: simulator.\r\t\t\t\t\tmacroMetricsSeries addToSeries: (Array with: p with: s) -> data ")" ] ].\r\t^ exporter visit: macroMetricsSeries',
			#category : #examples,
			#selector : #example8b,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.301007+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'exampleBrittany\r\t"Simple case - no loss"\r\r\t| parameters rawPoints ordered simulator |\r\tparameters := MacroSimulatorParameters new\r\t\tnumberOfDrones: 450;\r\t\tnominalSpeed: 130000 / 60;\r\t\tminSpeed: 60000 / 60;\r\t\tmaxSpeed: 220000 / 60;\r\t\tsensingRadius: 3;\r\t\tcaptureRadius: 8;\r\t\tyourself.\r\trawPoints := (MacroSimulatorParameters generateRawBrittanyPoints: 100 seed: parameters seed)\r\t\tcollect: [ :entry |\r\t\t\tGeoPoint latitude: (entry at: #lat)\r\t\t\t\tlongitude: (entry at: #lng)\r\t\t\t\taltitude: (entry at: #alt) ].\r\tordered := MacroSimulatorParameters orderedRouteFromRawPoints: rawPoints.\r\tparameters wayPoints: (MacroSimulatorParameters compactedRouteFrom: ordered compactingFactorLegacy: 0.3).\r\tsimulator := parameters initializeSimulator.\r\tsimulator run: 50.\r\t^ simulator inspect',
			#category : #examples,
			#selector : #exampleBrittany,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.307497+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example2\r\t"Simple case - one loss"\r\r\t| parameters simulator |\r\tparameters := MacroSimulatorParameters example1.\r\r\tsimulator := parameters initializeSimulator.\r\tsimulator loose: 1 at: 20.\r\tsimulator run: 50.\r\t^ simulator inspect',
			#category : #examples,
			#selector : #example2,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.286433+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example6\r\t"Prospection - incoming drone "\r\r\t| parameters simulator pacingRates sensibilities exporter |\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example6\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.97. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 100;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              yourself.\r\tparameters policy: #capingPolicy.\r\r\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\t 1 to: 20 do:[:i| \tsimulator loose: i at: i*20+100].\r\t\t\t\t\t\t"30 timesRepeat:[simulator newIncomerAt: 500]".\r\t\t\t\t\tsimulator run: 1500.\r\t\t\t\t\texporter visit: simulator ] ].\r\r\t^ simulator',
			#category : #examples,
			#selector : #example6,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.290685+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'observerPerceptionOver: ground wayPoints: wayPoints\r\r\t| source points segments perimeter perception view |\r\tsource := PerceptionAdapter fromDirectory: ground.\r\tpoints := source projectPolygon: wayPoints.\r\tsegments := OrderedCollection new.\r\tperimeter := 0.0.\r\r\t"Chaque segment contient ses extrémités et ses deux distances cumulées."\r\tpoints withIndexDo: [ :a :i |\r\t\t\t| b fin |\r\t\t\tb := points at: i \\\\ points size + 1.\r\t\t\tfin := perimeter + (a distanceTo: b).\r\t\t\tfin > perimeter ifTrue: [\r\t\t\t\t\tsegments add: {\r\t\t\t\t\t\t\ta.\r\t\t\t\t\t\t\tb.\r\t\t\t\t\t\t\tperimeter.\r\t\t\t\t\t\t\tfin }.\r\t\t\t\t\tperimeter := fin ] ].\r\r\tperception := PerceptionAdapter on: source terrain.\r\tperception cameraHalfFieldTangent: 0.4 sensorSidePixels: 2000.\r\tview := PerceptionRoassalView on: perception.\r\r\t^ [ :etape :secondes |\r\t\t  | tour poses |\r\t\t  tour := etape range.\r\t\t  poses := etape drones collect: [ :drone |\r\t\t\t\t           | distance segment fraction |\r\t\t\t\t           distance := drone position \\\\ tour / tour * perimeter.\r\t\t\t\t           segment := segments\r\t\t\t\t\t                      detect: [ :chacun |\r\t\t\t\t\t                      distance < chacun fourth ]\r\t\t\t\t\t                      ifNone: [ segments last ].\r\t\t\t\t           fraction := distance - segment third\r\t\t\t\t                       / (segment fourth - segment third).\r\t\t\t\t           PerceptionDronePose\r\t\t\t\t\t           id: drone id\r\t\t\t\t\t           position:\r\t\t\t\t\t           (segment first\r\t\t\t\t\t\t            interpolateTo: segment second\r\t\t\t\t\t\t            at: fraction)\r\t\t\t\t\t           heightAboveGround: 200 ].\r\t\t  perception recordAt: secondes polygon: points drones: poses.\r\t\t  view ]',
			#category : #examples,
			#selector : #'observerPerceptionOver:wayPoints:',
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.311077+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example4\r\t"Idem example 2 : Simple case - one loss"\r\r\t"Change behavior -ie. speed adjustement policy - to be smoother"\r\r\t| parameters simulator |\r\tparameters := MacroSimulatorParameters example1.\r"\tparameters policy: #capingPolicy."\r\tsimulator := parameters initializeSimulator.\r\tsimulator loose: 1 at: 20.\r\tsimulator run: 3000.\r\tsimulator evaluateMetrics inspect.\r\t^simulator inspect',
			#category : #examples,
			#selector : #example4,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.287741+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'legacyOutputDirectoryFor: aName\r\t| timestamp |\r\ttimestamp := self timeStampForNaming copyReplaceAll: \':\' with: \'-\'.\r\t^ FileLocator home / \'ExportsMacro\' /\r\t\t(aName , \'-\' , timestamp , \'-\' , UUID new asString)',
			#category : #examples,
			#selector : #'legacyOutputDirectoryFor:',
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.308515+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example3\r\t"Idem example 2 : Simple case - one loss"\r\r\t"Change behavior -ie. speed adjustement policy - to be smoother"\r\r\t| parameters simulator |\r\tparameters := MacroSimulatorParameters example1.\r\tparameters policy: #capingPolicy.\r\tsimulator := parameters initializeSimulator.\r\tsimulator loose: 1 at: 20.\r\tsimulator run: 3000.\r\tsimulator evaluateMetrics inspect.\r\t^simulator inspect',
			#category : #examples,
			#selector : #example3,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.287124+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example8GUI\r\t"Prospection - in/out drone "\r\r\t" self example8GUI"\r\r\t| parameters simulator pacingRates sensibilities observer view ground wayPoints timeAtTick images |\r\t"definition des waypoints et du terrain"\r\t"On utilise le mnt autour de Valence dans un premier temps"\r\ttimeAtTick :=[:t| t *100].\r\tground := FileLocator home / \'terrain-valence\'.\r\twayPoints := (0 to: 11) collect: [ :i |\r    | angle |\r    angle := i * 2 * Float pi / 30.\r    (4.8875 + (0.00508 * angle cos)) @\r        (44.9386 + (0.00360 * angle sin)) ].\r\tobserver := self observerPerceptionOver: ground wayPoints: wayPoints.\r\tpacingRates := { 0.9. 0.95. 0.99 }.\r\tsensibilities := { 0.01 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 10;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              policy: #capingPolicy;\r\t\t              seed: 3950149054165;\r\t\t              yourself.\r\r\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: sensibilities first;\r\t\t\t\t\t\tpacingRate: pacingRates first.\r\t\t\t\t\tsimulator loose: 1 at: 200.\r\t\t\t\t"\tsimulator loose: 30 at: 500.\r\t\t\t\t\tsimulator loose: 80 at: 800.\r\t\t\t\t\tsimulator newIncomerAt: 500."\r\t\t\t\t\tsimulator newIncomerAt: 500.\r\t\t\t\t"\tsimulator newIncomerAt: 1000."\r\r\r\r\t15 timesRepeat: [ simulator run: 100 ].\r\r\timages := (self legacyOutputDirectoryFor: \'valence\') ensureCreateDirectory.\r\t1 to: 1500 by:100 do:[:i| |step| step := simulator history at:i.\r\t\t\tview := observer\r\t\t\t\t        value: step\r\t\t\t\t        value: (timeAtTick value: step timeStep).\r\t\t\tPNGReadWriter\r        putForm: view asForm\r        onFileNamed: (images / (\'valence-\', step timeStep printString, \'.png\')) fullName ].\r\tview open',
			#category : #examples,
			#selector : #example8GUI,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.313327+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'example6b\r\t"Prospection - incoming drone "\r\r\t| parameters simulator pacingRates sensibilities exporter |\r\texporter := MacroExporter directoryName: (self legacyOutputDirectoryFor: \'example6b\') fullName. "exporter is Unique to ensure directory consistency"\r\tpacingRates := { 0.9. 0.91. 0.92. 0.93. 0.94. 0.95. 0.96. 0.97. 0.98.\r\t               0.99 }.\r\tsensibilities := { 0.005. 0.01. 0.015. 0.02 }.\r\tparameters := MacroSimulatorParameters new\r\t\t              numberOfDrones: 20;\r\t\t              nominalSpeed: 10;\r\t\t              maxSpeed: 15;\r\t\t              sensingRadius: 20;\r\t\t              captureRadius: 20;\r\t\t              totalDistance: 10000;\r\t\t              yourself.\r\tparameters policy: #capingPolicy.\r\r\r\r\tpacingRates do: [ :p |\r\t\t\tsensibilities do: [ :s |\r\t\t\t\t\tsimulator := parameters initializeSimulator.\r\t\t\t\t\tsimulator behavior\r\t\t\t\t\t\tsensibility: s;\r\t\t\t\t\t\tpacingRate: p.\r\t\t\t\t\t" 1 to: 20 do:[:i| \tsimulator loose: i at: i*20+100]."\r\t\t\t\t\t\t30 timesRepeat:[simulator newIncomerAt: 500].\r\t\t\t\t\tsimulator run: 1500.\r\t\t\t\t\texporter visit: simulator ] ].\r\r\t^ simulator',
			#category : #examples,
			#selector : #example6b,
			#className : #MacroSimulatorExample,
			#timeStamp : '2026-11-24T17:03:20.292176+01:00'
		},
		MCClassDefinition {
			#name : #FullAppMacroReplay,
			#superclassName : #Object,
			#variables : OrderedCollection [ ],
			#packageName : #DroneSystem-Macro,
			#type : #normal,
			#comment : 'Rejeux unitaires du profil macro. SoSe reprend une combinaison de paramètres de l’exemple 8. ISSe conserve la séquence de graines et le générateur de scénarios de MacroSimulatorExample.\r\r    FullAppMacroReplay soSe history inspect.\r    (FullAppMacroReplay isSeWithSeedIndex: 10) evaluateMetrics inspect.\r\rLe rejeu Vercors se trouve dans PerceptionVercorsMissionExample.',
			#commentStamp : 'FullApp',
			#tagName : #Replay,
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCClassDefinition {
			#name : #SoSeVercorsExample,
			#superclassName : #Object,
			#variables : OrderedCollection [
				MCInstanceVariableDefinition {
					#name : 'replay'
				}
			],
			#packageName : #DroneSystem-Macro,
			#type : #normal,
			#comment : 'Exemple de SoSe sur la boucle du Vercors avec observation hybride des voisins et rendu des relevés du MNT. Charger reprise-distances.st pour partager les sommets projetés en mètres entre la commande et le rejeu.\r\rexample := SoSeVercorsExample vercorsFrom: bundle / \'rejeu-vercors\'.\rsimulator := example simulate.\rexample replay playHistory: simulator history every: 5.\rexample export: simulator every: 5 into: output.\r\rLe scénario fait disparaître d’abord la mesure de distance, puis le gisement. Avec les lois à deux écarts, un drone qui ne dispose plus de deux valeurs exploitables garde sa dernière vitesse. Lorsque les écarts redeviennent exploitables, la loi s’applique au tik courant. Le rendu optique du MNT lit l’historique et possède sa propre configuration.\r',
			#commentStamp : 'SoSe',
			#tagName : #Replay,
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'visibleCellsForPose: pose\r    "Relit uniquement le champ instantané de cette pose, sans changer le dernier relevé."\r    | cells |\r    cells := Dictionary new.\r    self observePose: pose do: [ :cell :gsd | cells at: cell - gridOffset put: gsd ].\r    ^ cells\r',
			#category : #simulation,
			#selector : #'visibleCellsForPose:',
			#className : #PerceptionCoverageAdapter,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'verdictAt: seconds fresh: fresh unknown: unknown total: total\r    (seconds < startSeconds or: [ endSeconds notNil and: [ seconds > endSeconds ] ])\r        ifTrue: [ ^ #notApplicable ].\r    fresh asFloat / total >= minimumFreshRatio ifTrue: [ ^ #satisfied ].\r    (fresh + unknown) asFloat / total >= minimumFreshRatio ifTrue: [ ^ #unknown ].\r    ^ #violated\r',
			#category : #evaluating,
			#selector : #'verdictAt:fresh:unknown:total:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'measureOn: adapter includesCell: includesCell total: total unknown: unknown\r    | instant fresh stale oldest now verdict |\r    instant := fresh := stale := 0.\r    now := adapter time.\r    adapter visibleGridObservationsDo: [ :cell :reading |\r        (includesCell value: cell) ifTrue: [\r            | age |\r            age := now - reading first.\r            oldest := oldest ifNil: [ age ] ifNotNil: [ oldest max: age ].\r            age = 0 ifTrue: [ instant := instant + 1 ].\r            age < maximumAgeSeconds\r                ifTrue: [ fresh := fresh + 1 ]\r                ifFalse: [ stale := stale + 1 ] ] ].\r    verdict := self verdictAt: now fresh: fresh unknown: unknown total: total.\r    ^ {\r        #opticalCoverageRatio -> (instant asFloat / total).\r        #freshCoverageRatio -> (fresh asFloat / total).\r        #staleCoverageRatio -> (stale asFloat / total).\r        #neverObservedRatio -> ((total - unknown - fresh - stale) asFloat / total).\r        #unknownSurfaceRatio -> (unknown asFloat / total).\r        #maxObservationAgeSeconds -> oldest.\r        #freshnessStatus -> verdict } asDictionary\r',
			#category : #evaluating,
			#selector : #'measureOn:includesCell:total:unknown:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'activeFromSeconds: first through: last\r    (first isNumber and: [ first asFloat isFinite and: [ first >= 0 and: [\r        last isNil or: [ last isNumber and: [ last asFloat isFinite and: [ last >= first ] ] ] ] ] ])\r            ifFalse: [ self error: \'La fenêtre du contrat doit être croissante et en secondes.\' ].\r    startSeconds := first.\r    endSeconds := last\r',
			#category : #configuration,
			#selector : #'activeFromSeconds:through:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'monitorOn: terrain\r    "La zone est discrétisée une fois. Les mesures lisent le dernier relevé confirmé par case."\r    | total unknown includesCell first last |\r    (terrain projectedBounds containsRect: zone)\r        ifFalse: [ self error: \'La zone du contrat doit tenir dans l’emprise du MNT.\' ].\r    first := terrain gridCoordinatesOf: zone origin x @ zone corner y.\r    last := terrain gridCoordinatesOf: zone corner x @ zone origin y.\r    includesCell := [ :cell | zone containsPoint:\r        (terrain projectedCenterAtColumn: cell x row: cell y) ].\r    total := unknown := 0.\r    (first y floor max: 0) to: (last y ceiling min: terrain rows - 1) do: [ :y |\r        (first x floor max: 0) to: (last x ceiling min: terrain columns - 1) do: [ :x |\r            (includesCell value: x @ y) ifTrue: [\r                total := total + 1.\r                (terrain surfaceAtColumn: x row: y) ifNil: [ unknown := unknown + 1 ] ] ] ].\r    total = 0 ifTrue: [ self error: \'La zone du contrat ne contient aucun centre de case.\' ].\r    ^ [ :adapter | self measureOn: adapter includesCell: includesCell total: total unknown: unknown ]\r',
			#category : #evaluating,
			#selector : #'monitorOn:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'initializeZone: aRectangle maximumAgeSeconds: limit minimumFreshRatio: target\r    ((aRectangle isKindOf: Rectangle) and: [\r        aRectangle width > 0 and: [ aRectangle height > 0 ] ])\r            ifFalse: [ self error: \'La zone de fraîcheur doit être un rectangle projeté de surface positive.\' ].\r    (limit isNumber and: [ limit asFloat isFinite and: [ limit > 0 ] ])\r        ifFalse: [ self error: \'La limite d’âge doit être finie et strictement positive.\' ].\r    (target isNumber and: [ target between: 0 and: 1 ])\r        ifFalse: [ self error: \'Le ratio de service doit être compris entre 0 et 1.\' ].\r    zone := aRectangle copy.\r    maximumAgeSeconds := limit.\r    minimumFreshRatio := target.\r    startSeconds := 0\r',
			#category : #configuration,
			#selector : #'initializeZone:maximumAgeSeconds:minimumFreshRatio:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'zone: aRectangle maximumAgeSeconds: limit minimumFreshRatio: target\r    ^ self new initializeZone: aRectangle maximumAgeSeconds: limit minimumFreshRatio: target\r',
			#category : #'instance creation',
			#selector : #'zone:maximumAgeSeconds:minimumFreshRatio:',
			#className : #PerceptionFreshnessContract,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'droneColorFor: id\r    | acceleration threshold |\r    self droneColorMode = #acceleration ifFalse: [ ^ self speedColorFor: id ].\r    acceleration := accelerations at: id ifAbsent: [ 0 ].\r    threshold := self accelerationThreshold.\r    acceleration < threshold negated ifTrue: [ ^ movementColors first ].\r    acceleration > threshold ifTrue: [ ^ movementColors third ].\r    ^ movementColors second\r',
			#category : #drawing,
			#selector : #'droneColorFor:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'overlayFor: aTerrain\r    | overlay hatch fadeColor fadesToTransparency |\r    overlay := Form extent: aTerrain columns @ aTerrain rows depth: 32.\r    self showsCoverage ifTrue: [\r        fadeColor := options at: #fadeColor ifAbsent: [ Color fromHexString: \'F8FBFF\' ].\r        fadesToTransparency := adapter transparentAfterSeconds notNil.\r        adapter visibleGridObservationsDo: [ :cell :reading |\r            | grade color opacity |\r            grade := gsdLimits findFirst: [ :limit | reading second <= limit ].\r            color := (colors at: (grade = 0 ifTrue: [ 5 ] ifFalse: [ grade ]))\r                mixed: 1 - (adapter whitenessOf: reading) with: fadeColor.\r            opacity := fadesToTransparency\r                ifTrue: [ 0.90 * (adapter opacityOf: reading) ] ifFalse: [ 0.74 ].\r            overlay colorAt: cell put: (color alpha: opacity) ].\r        (options at: #showMasks ifAbsent: [ true ]) ifTrue: [\r            hatch := (self maskColor alpha: 0.85).\r            adapter shadowGridCellsDo: [ :cell |\r                ((cell x + cell y) \\\\ 5) < 2 ifTrue: [\r                    overlay colorAt: cell put: hatch ] ] ] ].\r    self highlightFocusOn: overlay.\r    ^ overlay\r',
			#category : #drawing,
			#selector : #'overlayFor:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'accelerationThreshold\r    ^ options at: #accelerationThreshold ifAbsent: [ 0 ]\r',
			#category : #configuration,
			#selector : #accelerationThreshold,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'annotateAccelerations: values\r    accelerations := values\r',
			#category : #configuration,
			#selector : #'annotateAccelerations:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'highlightFocusOn: overlay\r    focusCells := Dictionary new.\r    (focus isNil or: [ (focus at: #pose) isNil ]) ifTrue: [ ^ self ].\r    focusCells := adapter visibleCellsForPose: (focus at: #pose).\r    (options at: #showFocusFootprint ifAbsent: [ true ]) ifTrue: [\r        focusCells keysDo: [ :cell | overlay colorAt: cell put: (self focusColor alpha: 0.72) ] ]\r',
			#category : #drawing,
			#selector : #'highlightFocusOn:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'configureColors\r    speedRatioLimits := options at: #speedRatioLimits ifAbsent: [ #(0.95 1.05) ].\r    (speedRatioLimits size = 2 and: [\r        (speedRatioLimits allSatisfy: [ :value | value isNumber and: [ value asFloat isFinite ] ])\r            and: [ speedRatioLimits first >= 0 and: [\r                speedRatioLimits first <= 1 and: [ speedRatioLimits second >= 1 ] ] ] ])\r        ifFalse: [ self error: \'Les deux seuils de vitesse doivent encadrer le rapport 1.\' ].\r    movementColors := options at: #movementColors ifAbsent: [\r        { Color fromHexString: \'62C6FF\'. Color white. Color fromHexString: \'FFAE68\' } ].\r    colors := options at: #coverageColors ifAbsent: [ colors ].\r    ((movementColors size = 3 and: [ colors size = 5 ]) and: [\r        (movementColors, colors) allSatisfy: [ :color | color isKindOf: Color ] ])\r        ifFalse: [ self error: \'Donner trois couleurs de mouvement et cinq couleurs de finesse.\' ].\r    gsdLimits := options at: #gsdLimits ifAbsent: [ #(0.15 0.30 0.45 0.65) ].\r    (gsdLimits size = 4 and: [\r        (gsdLimits allSatisfy: [ :value | value isNumber and: [ value asFloat isFinite and: [ value > 0 ] ] ])\r            and: [ gsdLimits asSet size = 4 and: [ gsdLimits asSortedCollection asArray = gsdLimits asArray ] ] ])\r        ifFalse: [ self error: \'Donner quatre seuils de finesse strictement croissants.\' ]\r',
			#category : #configuration,
			#selector : #configureColors,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'focusColor\r    ^ options at: #focusColor ifAbsent: [ Color fromHexString: \'72F6EF\' ]\r',
			#category : #drawing,
			#selector : #focusColor,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawPolygon\r    (options at: #showRoute ifAbsent: [ true ]) ifTrue: [ super drawPolygon ]\r',
			#category : #drawing,
			#selector : #drawPolygon,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawDroneLabel: id status: status at: point color: color\r    | parts |\r    parts := OrderedCollection new.\r    (options at: #showDroneNames ifAbsent: [ true ]) ifTrue: [ parts add: id asString ].\r    (options at: #showDroneStatus ifAbsent: [ false ]) ifTrue: [ parts add: status ].\r    parts ifNotEmpty: [ self label: (\' · \' join: parts) at: point size: 12 color: color ]\r',
			#category : #drawing,
			#selector : #'drawDroneLabel:status:at:color:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'initializeOn: anAdapter options: settings\r    | mode threshold |\r    super initializeOn: anAdapter.\r    options := settings copy.\r    (#(hillshade elevation none) includes: (options at: #background ifAbsent: [ #hillshade ]))\r        ifFalse: [ self error: \'Fond de carte inconnu.\' ].\r    mode := self droneColorMode.\r    (#(speed acceleration none) includes: mode)\r        ifFalse: [ self error: \'Mode de couleur des drones inconnu.\' ].\r    mode = #acceleration ifTrue: [\r        threshold := self accelerationThreshold.\r        (threshold isNumber and: [ threshold >= 0 and: [ threshold asFloat isFinite ] ])\r            ifFalse: [ self error: \'Le seuil d’accélération doit être positif ou nul et fini.\' ] ].\r    canvas extent: 960 @ 740.\r    self configureColors.\r    speedRatios := Dictionary new.\r    accelerations := Dictionary new.\r    focusCells := Dictionary new.\r    losses := intruders := #()\r',
			#category : #configuration,
			#selector : #'initializeOn:options:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawLegend\r    | y muted coverage mode |\r    coverage := self showsCoverage.\r    self label: \'Temps simulé  \', ((adapter time ifNil: [ 0 ]) printShowingDecimalPlaces: 2), \' s\'\r        at: 16 @ 10 size: 18 color: Color white.\r    (adapter polygonIncludedInTerrain not or: [ adapter footprintMayBeClipped ]) ifTrue: [\r        self label: \'Bord du modèle de terrain\' at: canvas extent x - 211 @ 14\r            size: 13 color: (Color fromHexString: \'F5DD86\') ].\r    y := canvas extent y - 49.\r    muted := Color fromHexString: \'C0CEE0\'.\r    mode := self droneColorMode.\r    (mode ~= #none and: [ options at: #showDrones ifAbsent: [ true ] ]) ifTrue: [\r        | labels |\r        labels := mode = #acceleration\r            ifTrue: [ #( \'Accélération\' \'Freine\' \'Stable\' \'Accélère\' ) ]\r            ifFalse: [ #( \'Vitesse\' \'Lente\' \'Nominale\' \'Rapide\' ) ].\r        self label: labels first at: 445 @ y size: 13 color: muted.\r        self label: labels second at: 552 @ y size: 13 color: movementColors first.\r        self label: labels third at: 614 @ y size: 13 color: movementColors second.\r        self label: labels fourth at: 697 @ y size: 13 color: movementColors third ].\r    coverage ifTrue: [\r        self drawCoverageLegendAt: y color: muted.\r        (options at: #showMasks ifAbsent: [ true ]) ifTrue: [\r            self label: \'Hachures · masque\' at: 777 @ y size: 13 color: self maskColor ].\r        adapter transparentAfterSeconds ifNotNil: [ :seconds |\r            self label: \'Transparent à \', seconds printString, \' s\'\r                at: 270 @ (y + 21) size: 13 color: muted ] ].\r    (self showsLossMarkers and: [ (options at: #lossMarkerSeconds ifAbsent: [ 0 ]) > 0 ]) ifTrue: [\r        self label: \'Croix · retrait\' at: 460 @ (y + 21)\r            size: 13 color: self lossColor ].\r    intruders ifNotEmpty: [\r        self label: \'Point doré · détecté\' at: 760 @ (y + 21)\r            size: 13 color: (Color fromHexString: \'FFE48F\') ]\r',
			#category : #drawing,
			#selector : #drawLegend,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawLossMarker: marker\r    | point color |\r    (adapter terrain includesProjectedPoint: marker second) ifFalse: [ ^ self ].\r    point := self screenPoint: marker second.\r    color := self lossColor.\r    self drawLineFrom: point - (5 @ 5) to: point + (5 @ 5) color: color.\r    self drawLineFrom: point + (-5 @ 5) to: point + (5 @ -5) color: color.\r    self drawDroneLabel: marker first status: \'retiré\' at: point + (7 @ -15) color: color\r',
			#category : #drawing,
			#selector : #'drawLossMarker:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawActivePose: pose\r    | point |\r    (adapter terrain includesProjectedPoint: pose position) ifFalse: [ ^ self ].\r    point := self screenPoint: pose position.\r    self dotAt: point size: (options at: #droneMarkerSize ifAbsent: [ 9 ])\r        color: (self droneColorFor: pose id).\r    self drawDroneLabel: pose id status: \'actif\' at: point + (6 @ -17) color: Color white\r',
			#category : #drawing,
			#selector : #'drawActivePose:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'coverageAdapter\r    ^ adapter\r',
			#category : #configuration,
			#selector : #coverageAdapter,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawFocus\r    | panel position pose color count text |\r    focus ifNil: [ ^ self ].\r    position := focus at: #position.\r    pose := focus at: #pose.\r    color := self focusColor.\r    panel := RSBox new width: 326; height: 113; color: (Color fromHexString: \'142337\'); yourself.\r    panel translateTo: 179 @ 107.\r    self addFixed: panel.\r    self label: (\'Drone \', (focus at: #id) asString, \' · \', (pose ifNil: [ \'retiré\' ] ifNotNil: [ \'actif\' ]))\r        at: 26 @ 59 size: 15 color: color.\r    self label: (\'Position  \', (position x printShowingDecimalPlaces: 0), \' / \',\r        (position y printShowingDecimalPlaces: 0), \' m · \', adapter terrain crs)\r        at: 26 @ 83 size: 12 color: Color white.\r    pose ifNil: [ ^ self ].\r    (adapter terrain includesProjectedPoint: position) ifTrue: [\r        self dotAt: (self screenPoint: position) size: 8 color: color ].\r    self label: (\'Vitesse  \', ((focus at: #speed) printShowingDecimalPlaces: 2), \' m/s\',\r        \'   Hauteur  \', (pose altitude printShowingDecimalPlaces: 0), \' m AGL\')\r        at: 26 @ 103 size: 12 color: Color white.\r    count := focusCells size.\r    text := \'Champ visible  \', count printString, \' cases\'.\r    count > 0 ifTrue: [ text := text, \' · \',\r        (focusCells values min printShowingDecimalPlaces: 2), \' m/px au mieux\' ].\r    self label: text at: 26 @ 123 size: 12 color: color\r',
			#category : #drawing,
			#selector : #drawFocus,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawCoverageLegendAt: y color: muted\r    self label: \'Finesse (m/px)\' at: 16 @ y size: 13 color: muted.\r    1 to: 5 do: [ :index |\r        | sign limit |\r        sign := index = 5 ifTrue: [ \'> \' ] ifFalse: [ \'≤ \' ].\r        limit := gsdLimits at: (index min: 4).\r        self label: sign, limit printString\r            at: 139 + (index - 1 * 63) @ y size: 13 color: (colors at: index) ].\r    self label: \'Blanc après \', adapter fadeSeconds printString, \' s sans passage\'\r        at: 16 @ (y + 21) size: 13 color: muted\r',
			#category : #drawing,
			#selector : #'drawCoverageLegendAt:color:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'drawDrones\r    (options at: #showDrones ifAbsent: [ true ]) ifTrue: [\r        adapter poses do: [ :pose | self drawActivePose: pose ] ].\r    self showsLossMarkers ifTrue: [\r        losses do: [ :marker | self drawLossMarker: marker ] ].\r    intruders do: [ :marker |\r        (adapter terrain includesProjectedPoint: marker second) ifTrue: [\r            self dotAt: (self screenPoint: marker second)\r                size: (marker third ifTrue: [ 12 ] ifFalse: [ 4 ])\r                color: (Color fromHexString: (marker third\r                    ifTrue: [ \'FFE48F\' ] ifFalse: [ \'8994A4\' ])) ] ].\r    self drawFocus\r',
			#category : #drawing,
			#selector : #drawDrones,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'speedColorFor: id\r    | ratio |\r    self droneColorMode = #speed ifFalse: [ ^ movementColors second ].\r    ratio := speedRatios at: id ifAbsent: [ 1 ].\r    ratio < speedRatioLimits first ifTrue: [ ^ movementColors first ].\r    ratio > speedRatioLimits second ifTrue: [ ^ movementColors third ].\r    ^ movementColors second\r',
			#category : #drawing,
			#selector : #'speedColorFor:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'showsCoverage\r    ^ options at: #showCoverage ifAbsent: [ true ]\r',
			#category : #configuration,
			#selector : #showsCoverage,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'maskColor\r    ^ options at: #maskColor ifAbsent: [ Color fromHexString: \'F879A7\' ]\r',
			#category : #drawing,
			#selector : #maskColor,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'droneColorMode\r    ^ options at: #droneColorMode ifAbsent: [\r        (options at: #showSpeedColors ifAbsent: [ false ])\r            ifTrue: [ #speed ]\r            ifFalse: [ #none ] ]\r',
			#category : #configuration,
			#selector : #droneColorMode,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'showsLossMarkers\r    ^ options at: #showLossMarkers ifAbsent: [ true ]\r',
			#category : #configuration,
			#selector : #showsLossMarkers,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'lossColor\r    ^ options at: #lossColor ifAbsent: [ Color fromHexString: \'FF706B\' ]\r',
			#category : #drawing,
			#selector : #lossColor,
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'annotateFocus: details\r    focus := details\r',
			#category : #configuration,
			#selector : #'annotateFocus:',
			#className : #PerceptionMissionView,
			#timeStamp : ''
		},
		MCMethodDefinition {
