			#classIsMeta : false,
			#source : 'maxObservationAgeSeconds\r    ^ freshness at: #maxObservationAgeSeconds\r',
			#category : #freshness,
			#selector : #maxObservationAgeSeconds,
			#className : #MacroSimulatorFreshnessMetrics,
