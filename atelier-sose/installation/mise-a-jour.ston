'crs\' ] ].\r\tepsg := self epsgMetrique: (self descriptionCrs: cible).\r\tepsg ifNil: [\r\t\tself error: \'La grille exige un CRS EPSG projeté en mètres\' ].\r\tdx := self nombre: (options\r\t\t\t       at: #pas\r\t\t\t       ifAbsent: [\r\t\t\t       ancien\r\t\t\t\t       ifNil: [ 20 ]\r\t\t\t\t       ifNotNil: [ (ancien at: \'cellSize\') first ] ]).\r\tdy := self nombre: (options at: #pasNord ifAbsent: [\r\t\t\t\t       (ancien isNil or: [ options includesKey: #pas ])\r\t\t\t\t\t       ifTrue: [ dx ]\r\t\t\t\t\t       ifFalse: [ (ancien at: \'cellSize\') second ] ]).\r\tmarge := self nombre: (options at: #marge ifAbsent: [ 700 ]).\r\t(dx > 0 and: [ dy > 0 and: [ marge >= 0 ] ]) ifFalse: [\r\t\tself error: \'Vérifier les pas et la marge\' ].\r\tancien ifNotNil: [\r\t\t\t((ancien at: \'crs\') = epsg and: [\r\t\t\t\t\t (ancien at: \'cellSize\') asArray = {\r\t\t\t\t\t\t dx.\r\t\t\t\t\t\t dy } ]) ifFalse: [\r\t\t\t\tself error: \'Pour étendre, conserver le CRS et les deux pas\' ] ].\r\tprojetes := self projeter: points de: crs vers: epsg.\r\tgrille := self\r\t\t          grillePour: projetes\r\t\t          pas: {\r\t\t\t\t          dx.\r\t\t\t\t          dy }\r\t\t          marge: marge\r\t\t          ancien: ancien.\r\tmnt := (options at: #mnt ifAbsent: [ nil ]) ifNotNil: [ :chemin |\r\t\t       chemin asFileReference asAbsolute ].\r\tmns := (options at: #mns ifAbsent: [ nil ]) ifNotNil: [ :chemin |\r\t\t       chemin asFileReference asAbsolute ].\r\tfournisseur := mnt\r\t\t               ifNil: [ options at: #source ifAbsent: [ \'auto\' ] ]\r\t\t               ifNotNil: [ \'geotiff\' ].\r\tfournisseur = \'auto\' ifTrue: [ fournisseur := region ].\r\t(mnt isNil and: [ (#( \'ign\' \'usgs\' ) includes: fournisseur) not ])\r\t\tifTrue: [\r\t\tself error: \'Choisir IGN ou USGS, ou fournir un MNT local\' ].\r\traster := mnt\r\t\t          ifNil: [ self relief: fournisseur epsg: epsg ]\r\t\t          ifNotNil: [ self raster: mnt grille: grille epsg: epsg ].\r\tself ecrir