				#source : 'initializeOn: anAdapter options: settings\r    | mode threshold |\r    super initializeOn: anAdapter.\r    options := settings copy.\r    (#(hillshade elevation none) includes: (options at: #background ifAbsent: [ #hillshade ]))\r        ifFalse: [ self error: \'Fond de carte inconnu.\' ].\r    mode := self droneColorMode.\r    (#(speed acceleration none) includes: mode)\r        ifFalse: [ self error: \'Mode de couleur des drones inconnu.\' ].\r    mode = #acceleration ifTrue: [\r        threshold := self accelerationThreshold.\r        (threshold isNumber and: [ threshold >= 0 and: [ threshold asFloat isFinite ] ])\r            ifFalse: [ self error: \'Le seuil d’accélération doit être positif ou nul et fini.\' ] ].\r    canvas extent: 960 @ 740.\r    speedRatios := Dictionary new.\r    accelerations := Dictionary new.\r    losses := intruders := #()\r',
