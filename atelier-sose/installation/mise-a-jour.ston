				#source : 'observerWith: settings heightAt: heightAt intrudersAt: intrudersAt\r    | adapter view lossSeconds visibleLosses knownLosses camera fade |\r    lossSeconds := settings at: #lossMarkerSeconds ifAbsent: [ 0 ].\r    (lossSeconds isNumber and: [ lossSeconds >= 0 and: [ lossSeconds asFloat isFinite ] ])\r        ifFalse: [ self error: \'La durée d’affichage d’une perte doit être finie et positive ou nulle.\' ].\r    camera := settings at: #camera ifAbsent: [ #(1.0 2000) ].\r    fade := settings at: #fadeAfterSeconds ifAbsent: [ 300 ].\r    adapter := PerceptionCoverageAdapter on: terrain copy.\r    adapter cameraHalfFieldTangent: camera first sensorSidePixels: camera second.\r    adapter fadeAfterSeconds: fade.\r    (settings at: #transparentAfterSeconds ifAbsent: [ nil ]) ifNotNil: [ :seconds |\r        adapter fadeOutDuration: seconds - fade ].\r    view := PerceptionMissionView on: adapter options: settings.\r    knownLosses := Set new.\r    visibleLosses := OrderedCollection new.\r    ^ [ :step :seconds |\r        | speeds poses newLosses positions points |\r        speeds := Dictionary new.\r        poses := step drones collect: [ :drone |\r            drone nominalSpeed > 0 ifTrue: [\r                speeds at: drone id put: drone currentSpeed / drone nominalSpeed ].\r            PerceptionDronePose id: drone id position: (self positionOf: drone in: step)\r                heightAboveGround: (heightAt value: step value: drone) ].\r        newLosses := OrderedCollection new.\r        lossSeconds > 0 ifTrue: [\r            step lostDrones do: [ :drone |\r                (knownLosses includes: drone id) ifFalse: [\r                    newLosses add: { drone id. self positionOf: drone in: step. seconds } ] ] ].\r        positions := (intrudersAt value: step) collect: [ :pair |\r            { pair first. self project: pair second } ].\r        adapter recordAt: seconds polygon: route drones: poses.\r        points := positions collect: [ :pair |\r            | reading |\r            reading := adapter observationAt: pair second.\r            { pair first. pair second. reading notNil and: [ reading first = seconds ] } ].\r        visibleLosses := visibleLosses select: [ :marker | seconds - marker third < lossSeconds ].\r        newLosses do: [ :marker | knownLosses add: marker first. visibleLosses add: marker ].\r        view annotateSpeeds: speeds losses: visibleLosses intruders: points.\r        view ]\r',
