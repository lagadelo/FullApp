			#PreparerTerrain,
			#'grillePour:pas:marge:ancien:',
			false
		] : OrderedCollection [
			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'grillePour: points pas: pas marge: marge ancien: ancien\r\r\t| bornes dx dy ax ay gauche droite bas haut precedent |\r\tbornes := (self emprise: points)\r\t\t          with: { -1. -1. 1. 1 }\r\t\t          collect: [ :bord :sens | bord + (marge * sens) ].\r\tdx := pas first.\r\tdy := pas second.\r\tax := 0.\r\tay := 0.\r\tancien ifNotNil: [\r\t\t\tax := (ancien at: \'topLeft\') first.\r\t\t\tay := (ancien at: \'topLeft\') second.\r\t\t\tprecedent := self bornes: {\r\t\t\t\t\t             ax.\r\t\t\t\t\t             ay.\r\t\t\t\t\t             dx.\r\t\t\t\t\t             dy.\r\t\t\t\t\t             (ancien at: \'columns\').\r\t\t\t\t\t             (ancien at: \'rows\') }.\r\t\t\tbornes := {\r\t\t\t\t          (bornes first min: precedent first).\r\t\t\t\t          (bornes second min: precedent second).\r\t\t\t\t          (bornes third max: precedent third).\r\t\t\t\t          (bornes fourth max: precedent fourth) } ].\r\tgauche := (bornes first - ax / dx + 1e-9) floor.\r\tbas := (bornes second - ay / dy + 1e-9) floor.\r\tdroite := (bornes third - ax / dx - 1e-9) ceiling.\r\thaut := (bornes fourth - ay / dy - 1e-9) ceiling.\r\t(gauche >= droite or: [ bas >= haut ]) ifTrue: [\r\t\tself error: \'Emprise vide\' ].\r\t^ {\r\t\t  (ax + (gauche * dx)).\r\t\t  (ay + (haut * dy)).\r\t\t  dx.\r\t\t  dy.\r\t\t  (droite - gauche).\r\t\t  (haut - bas) }',
				#category : #grille,
				#selector : #'grillePour:pas:marge:ancien:',
				#className : #PreparerTerrain,
				#timeStamp : '2026-11-24T17:03:19.5562+01:00'
			}
