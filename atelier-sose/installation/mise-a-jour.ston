				#source : 'produire: fichier dans: dossier options: options\r\r\t| polygone points crs sourceMetrique origine yBas localisation emprise region ancien cible epsg projetes dx dy marge mnt mns fournisseur raster meta |\r\tpolygone := self polygone: fichier.\r\tpoints := polygone first.\r\tcrs := options\r\t\t       at: #crsPoints\r\t\t       ifAbsent: [ polygone second ifNil: [ \'EPSG:4326\' ] ].\r\tsourceMetrique := self epsgMetrique: (self descriptionCrs: crs).\r\torigine := options at: #origine ifAbsent: [ nil ].\r\tyBas := options at: #yVersLeBas ifAbsent: [ false ].\r\torigine\r\t\tifNil: [\r\t\tyBas ifTrue: [ self error: \'#yVersLeBas exige une origine\' ] ]\r\t\tifNotNil: [\r\t\t\t\tsourceMetrique ifNil: [\r\t\t\t\t\tself error: \'Une origine exige un CRS métrique\' ].\r\t\t\t\torigine := origine collect: [ :x | self nombre: x ].\r\t\t\t\tpoints := points collect: [ :xy |\r\t\t\t\t\t\t          {\r\t\t\t\t\t\t\t          (origine first + xy first).\r\t\t\t\t\t\t\t          (origine second + (xy second * (yBas\r\t\t\t\t\t\t\t\t             ifTrue: [ -1 ]\r\t\t\t\t\t\t\t\t             ifFalse: [ 1 ]))) } ] ].\r\tlocalisation := self projeter: points de: crs vers: \'EPSG:4326\'.\r\temprise := self emprise: localisation.\r\t(emprise first >= -180 and: [\r\t\t\t emprise third <= 180 and: [\r\t\t\t\t emprise second >= -90 and: [ emprise fourth <= 90 ] ] ])\r\t\tifFalse: [ self error: \'Sommets hors domaine\' ].\r\tregion := self region: emprise.\r\tancien := (options at: #etendre ifAbsent: [ nil ]) ifNotNil: [\r\t\t          :chemin |\r\t\t          self json: chemin asFileReference / \'terrain.json\' ].\r\tcible := options at: #crsGrille ifAbsent: [\r\t\t\t         ancien\r\t\t\t\t         ifNil: [\r\t\t\t\t\t\t         sourceMetrique ifNil: [\r\t\t\t\t\t\t\t\t         region = \'ign\'\r\t\t\t\t\t\t\t\t\t         ifTrue: [ \'EPSG:2154\' ]\r\t\t\t\t\t\t\t\t\t         ifFalse: [ self utm: localisation emprise: emprise ] ] ]\r\t\t\t\t         ifNotNil: [ ancien at: \'crs\' ] ].\r\tepsg := self epsgMetrique: (self descriptionCrs: cible).\r\tepsg ifNil: [\r\t\tself error: \'La grille exige un CRS EPSG projeté en mètres\' ].\r\tdx := self nombre: (options\r\t\t\t       at: #pas\r\t\t\t       ifAbsent: [\r\t\t\t       ancien\r\t\t\t\t       ifNil: [ 20 ]\r\t\t\t\t       ifNotNil: [ (ancien at: \'cellSize\') first ] ]).\r\tdy := self nombre: (options at: #pasNord ifAbsent: [\r\t\t\t\t       (ancien isNil or: [ options includesKey: #pas ])\r\t\t\t\t\t       ifTrue: [ dx ]\r\t\t\t\t\t       ifFalse: [ (ancien at: \'cellSize\') second ] ]).\r\tmarge := self nombre: (options at: #marge ifAbsent: [ 700 ]).\r\t(dx > 0 and: [ dy > 0 and: [ marge >= 0 ] ]) ifFalse: [\r\t\tself error: \'Vérifier les pas et la marge\' ].\r\tancien ifNotNil: [\r\t\t\t((ancien at: \'crs\') = epsg and: [\r\t\t\t\t\t (ancien at: \'cellSize\') asArray = {\r\t\t\t\t\t\t dx.\r\t\t\t\t\t\t dy } ]) ifFalse: [\r\t\t\t\tself error: \'Pour étendre, conserver le CRS et les deux pas\' ] ].\r\tprojetes := self projeter: points de: crs vers: epsg.\r\tgrille := self\r\t\t          grillePour: projetes\r\t\t          pas: {\r\t\t\t\t          dx.\r\t\t\t\t          dy }\r\t\t          marge: marge\r\t\t          ancien: ancien.\r\tmnt := (options at: #mnt ifAbsent: [ nil ]) ifNotNil: [ :chemin |\r\t\t       chemin asFileReference asAbsolute ].\r\tmns := (options at: #mns ifAbsent: [ nil ]) ifNotNil: [ :chemin |\r\t\t       chemin asFileReference asAbsolute ].\r\tfournisseur := mnt\r\t\t               ifNil: [ options at: #source ifAbsent: [ \'auto\' ] ]\r\t\t               ifNotNil: [ \'geotiff\' ].\r\tfournisseur = \'auto\' ifTrue: [ fournisseur := region ].\r\t(mnt isNil and: [ (#( \'ign\' \'usgs\' ) includes: fournisseur) not ])\r\t\tifTrue: [\r\t\tself error: \'Choisir IGN ou USGS, ou fournir un MNT local\' ].\r\traster := mnt\r\t\t          ifNil: [ self relief: fournisseur epsg: epsg ]\r\t\t          ifNotNil: [ self raster: mnt grille: grille epsg: epsg ].\r\tself ecrireCsv: raster dans: dossier / \'mnt.csv\'.\r\tmns ifNotNil: [\r\t\t\tself\r\t\t\t\tecrireCsv: (self raster: mns grille: grille epsg: epsg)\r\t\t\t\tdans: dossier / \'mns.csv\' ].\r\tmeta := {\r\t\t        (\'version\' -> 1).\r\t\t        (\'crs\' -> epsg).\r\t\t        (\'topLeft\' -> {\r\t\t\t         grille first.\r\t\t\t         grille second }).\r\t\t        (\'cellSize\' -> {\r\t\t\t         dx.\r\t\t\t         dy }).\r\t\t        (\'columns\' -> grille fifth).\r\t\t        (\'rows\' -> grille sixth).\r\t\t        (\'noData\' -> -9999.0).\r\t\t        (\'ground\' -> \'mnt.csv\').\r\t\t        (\'surface\' -> (mns ifNotNil: [ \'mns.csv\' ])).\r\t\t        (\'polygonProjected\' -> projetes).\r\t\t        (\'source\' -> fournisseur).\r\t\t        (\'inputCrs\' -> crs).\r\t\t        (\'inputOrigin\' -> origine).\r\t\t        (\'inputYDown\' -> yBas) } asDictionary.\r\tdossier / \'terrain.json\' writeStreamDo: [ :flux |\r\t\t\tflux\r\t\t\t\tnextPutAll: (STONJSON toString: meta);\r\t\t\t\tlf ]',
				#category : #execution,
