				#source : 'utm: points emprise: bornes\r\r\t| longitude latitude zone |\r\tlongitude := (points collect: #first) sum / points size.\r\tlatitude := (points collect: #second) sum / points size.\r\t(latitude > -80 and: [\r\t\t latitude < 84 and: [ bornes third - bornes first <= 180 ] ])\r\t\tifFalse: [ self error: \'Préciser le CRS métrique avec #crsGrille\' ].\r\tzone := ((longitude + 180 / 6) floor + 1 max: 1) min: 60.\r\t^ \'EPSG:\' , ((latitude >= 0\r\t\t    ifTrue: [ 32600 ]\r\t\t    ifFalse: [ 32700 ]) + zone) asString',
