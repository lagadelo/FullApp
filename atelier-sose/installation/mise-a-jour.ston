				#classIsMeta : false,
				#source : 'exportHistory: aHistory every: stride into: aDirectory\r    | nextFrame directory view index |\r    nextFrame := self frameReaderFor: aHistory every: stride.\r    directory := (aDirectory asFileReference / (\'images-\', UUID new asString)) ensureCreateDirectory.\r    index := 0.\r    view := nextFrame value.\r    [ view notNil ] whileTrue: [\r        | file |\r        file := directory / ((index printString padLeftTo: 4 with: $0), \'.png\').\r        file binaryWriteStreamDo: [ :stream | (PNGReadWriter on: stream) nextPutImage: view asForm ].\r        index := index + 1.\r        view := nextFrame value ].\r    ^ directory\r',
