			#category : #freshness,
			#selector : #freshCoverageRatio,
			#className : #MacroSimulatorFreshnessMetrics,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'freshness: report\r    freshness := report\r',
			#category : #freshness,
			#selector : #'freshness:',
			#className : #MacroSimulatorFreshnessMetrics,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'unknownSurfaceRatio\r    ^ freshness at: #unknownSurfaceRatio\r',
			#category : #freshness,
			#selector : #unknownSurfaceRatio,
			#className : #MacroSimulatorFreshnessMetrics,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'neverObservedRatio\r    ^ freshness at: #neverObservedRatio\r',
			#category : #freshness,
			#selector : #neverObservedRatio,
			#className : #MacroSimulatorFreshnessMetrics,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'on: step freshness: report\r    ^ (self on: step) freshness: report; yourself\r',
			#category : #'instance creation',
			#selector : #'on:freshness:',
			#className : #MacroSimulatorFreshnessMetrics,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'playHistory: aHistory every: stride\r    | nextFrame view animation lastFrame window extent |\r    nextFrame := self frameReaderFor: aHistory every: stride.\r    view := nextFrame value.\r    extent := view canvas extent + (20 @ 40).\r    lastFrame := Time millisecondClockValue.\r    animation := view canvas newAnimation.\r    animation\r        repeat;\r        onStepDo: [\r            (Time millisecondsSince: lastFrame) >= 80 ifTrue: [\r                nextFrame value\r                    ifNil: [ animation stop ]\r                    ifNotNil: [ :nextView | nextView refresh ].\r                lastFrame := Time millisecondClockValue ] ].\r    window := view open.\r    window extent: extent.\r    ^ window\r',
			#category : #replay,
			#selector : #'playHistory:every:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'writeTimelineImage: name duration: duration on: timeline\r    timeline nextPutAll: \'file \'; nextPut: $\'; nextPutAll: name; nextPut: $\'; lf.\r    timeline nextPutAll: \'option framerate 1000\'; lf.\r    duration ifNotNil: [\r        timeline nextPutAll: \'duration \'; nextPutAll: (duration printShowingDecimalPlaces: 6); lf ]\r',
			#category : #replay,
			#selector : #'writeTimelineImage:duration:on:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'heightAt: aBlock\r    "Le bloc reçoit le tik et le drone, et renvoie une hauteur au-dessus du sol en mètres."\r    heightAt := aBlock\r',
			#category : #configuration,
			#selector : #'heightAt:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'secondsPerTick\r    ^ secondsPerTick\r',
			#category : #configuration,
			#selector : #secondsPerTick,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'projectedWayPoints\r    ^ scene projectedWayPoints\r',
			#category : #configuration,
			#selector : #projectedWayPoints,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'checkedHistory: aHistory every: stride\r    | history |\r    (stride isInteger and: [ stride > 0 ])\r        ifFalse: [ self error: \'L’intervalle entre deux images doit être un entier positif.\' ].\r    history := aHistory asArray.\r    history ifEmpty: [ self error: \'L’historique est vide.\' ].\r    ^ history\r',
			#category : #replay,
			#selector : #'checkedHistory:every:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'evaluateMetricsOf: simulator freshness: contract\r    | observe measure rows |\r    observe := self newStepObserver.\r    measure := contract monitorOn: scene terrain.\r    rows := simulator history collect: [ :step |\r        | view |\r        view := observe value: step.\r        MacroSimulatorFreshnessMetrics on: step\r            freshness: (measure value: view coverageAdapter) ].\r    ^ MacroSimulatorMetricsHistory from: rows\r',
			#category : #metrics,
			#selector : #'evaluateMetricsOf:freshness:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'projectedPositionOfDrone: id in: step\r    "Renvoie un Point en mètres dans le CRS de grille, ou nil."\r    ^ step drones\r        detect: [ :drone | drone id = id ]\r        ifFound: [ :drone | scene positionOf: drone in: step ]\r        ifNone: [ nil ]\r',
			#category : #configuration,
			#selector : #'projectedPositionOfDrone:in:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'newSimulatorWith: configure\r    | parameters minSpeed nominalSpeed maxSpeed |\r    parameters := MacroSimulatorParameters new\r        numberOfDrones: 20;\r        totalDistance: self perimeterMeters;\r        minSpeed: 5;\r        nominalSpeed: 10;\r        maxSpeed: 15;\r        sensingRadius: 20;\r        captureRadius: 20;\r        policy: #capingPolicy;\r        seed: 3950149054165;\r        yourself.\r    configure value: parameters.\r    (parameters numberOfDrones isInteger and: [ parameters numberOfDrones > 0 ])\r        ifFalse: [ self error: \'L’effectif doit être un entier positif.\' ].\r    minSpeed := parameters minSpeed.\r    nominalSpeed := parameters nominalSpeed.\r    maxSpeed := parameters maxSpeed.\r    (({ minSpeed. nominalSpeed. maxSpeed } allSatisfy: [ :speed | speed isNumber and: [ speed asFloat isFinite ] ])\r        and: [ minSpeed >= 0 and: [ nominalSpeed > 0 and: [\r            minSpeed <= nominalSpeed and: [ nominalSpeed <= maxSpeed ] ] ] ])\r                ifFalse: [ self error: \'Les vitesses doivent respecter 0 ≤ min ≤ nominale ≤ max et nominale > 0.\' ].\r    "MacroSimulatorDrone >> update ajoute la vitesse à l’abscisse à chaque mouvement."\r    parameters\r        minSpeed: minSpeed * secondsPerTick;\r        nominalSpeed: nominalSpeed * secondsPerTick;\r        maxSpeed: maxSpeed * secondsPerTick.\r    ^ parameters initializeSimulator\r',
			#category : #simulation,
			#selector : #'newSimulatorWith:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'exportHistory: aHistory every: stride into: aDirectory\r    | nextFrame directory view index |\r    nextFrame := self frameReaderFor: aHistory every: stride.\r    directory := (aDirectory asFileReference / (\'images-\', UUID new asString)) ensureCreateDirectory.\r    index := 0.\r    view := nextFrame value.\r    [ view notNil ] whileTrue: [\r        self writeImageOf: view index: index into: directory.\r        index := index + 1.\r        view := nextFrame value ].\r    ^ directory\r',
			#category : #replay,
			#selector : #'exportHistory:every:into:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'heightAboveGround: metres\r    (metres isNumber and: [ metres asFloat isFinite and: [ metres > 0 ] ])\r        ifFalse: [ self error: \'La hauteur au-dessus du sol doit être positive et finie.\' ].\r    self heightAt: [ :step :drone | metres ]\r',
			#category : #configuration,
			#selector : #'heightAboveGround:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'scene: aScene\r    scene := aScene\r',
			#category : #initialization,
			#selector : #'scene:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'secondsPerTick: seconds\r    (seconds isNumber and: [ seconds asFloat isFinite and: [ seconds > 0 ] ])\r        ifFalse: [ self error: \'La durée d’un tik doit être positive et finie.\' ].\r    secondsPerTick := seconds\r',
			#category : #configuration,
			#selector : #'secondsPerTick:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'initialize\r    super initialize.\r    secondsPerTick := 1.\r    self heightAboveGround: 180.\r    displayOptions := {\r        #background -> #hillshade.\r        #showDroneNames -> false.\r        #showSpeedColors -> true.\r        #lossMarkerSeconds -> 40.\r        #fadeAfterSeconds -> 16.\r        #transparentAfterSeconds -> 28 } asDictionary\r',
			#category : #initialization,
			#selector : #initialize,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'writeImageOf: view index: index into: directory\r    | name |\r    name := (index printString padLeftTo: 4 with: $0), \'.png\'.\r    (directory / name) binaryWriteStreamDo: [ :stream |\r        (PNGReadWriter on: stream) nextPutImage: view asForm ].\r    ^ name\r',
			#category : #replay,
			#selector : #'writeImageOf:index:into:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'perimeterMeters\r    ^ scene perimeterMeters\r',
			#category : #configuration,
			#selector : #perimeterMeters,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'displayOptions\r    ^ displayOptions\r',
			#category : #configuration,
			#selector : #displayOptions,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'newStepObserver\r    | tickSeconds observe |\r    tickSeconds := secondsPerTick.\r    observe := scene observerWith: displayOptions\r        heightAt: heightAt\r        intrudersAt: [ :step | #() ]\r        secondsPerTick: tickSeconds.\r    ^ [ :step | observe value: step value: step timeStep * tickSeconds ]\r',
			#category : #replay,
			#selector : #newStepObserver,
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'freshnessContractFor: aRectangle minimumFreshRatio: target\r    "Fixe la limite d’âge au seuil actuel de blanchiment complet."\r    ^ PerceptionFreshnessContract\r        zone: aRectangle\r        maximumAgeSeconds: (displayOptions at: #fadeAfterSeconds ifAbsent: [ 300 ])\r        minimumFreshRatio: target\r',
			#category : #metrics,
			#selector : #'freshnessContractFor:minimumFreshRatio:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'exportTimedHistory: aHistory every: stride into: aDirectory rateAt: rateBlock\r    "rateBlock reçoit l’état puis un bloc id -> position projetée. Taux en secondes simulées par seconde de vidéo."\r    | history rates indices observe directory name frame |\r    history := self checkedHistory: aHistory every: stride.\r    rates := history collect: [ :step |\r        | rate |\r        rate := rateBlock value: step value: [ :id | self projectedPositionOfDrone: id in: step ].\r        (rate isNumber and: [ rate asFloat isFinite and: [ rate > 0 ] ])\r            ifFalse: [ self error: \'Le taux de lecture doit être fini et strictement positif.\' ].\r        rate asFloat ].\r    indices := OrderedCollection new.\r    1 to: history size do: [ :index |\r        ((index - 1 \\\\ stride = 0) or: [ index = history size or: [\r            (rates at: index) ~= (rates at: index - 1) ] ])\r                ifTrue: [ indices add: index ] ].\r    observe := self newStepObserver.\r    directory := (aDirectory asFileReference / (\'images-\', UUID new asString)) ensureCreateDirectory.\r    frame := 1.\r    (directory / \'lecture.ffconcat\') writeStreamDo: [ :timeline |\r        timeline nextPutAll: \'ffconcat version 1.0\'; lf.\r        history withIndexDo: [ :step :index |\r            | view |\r            view := observe value: step.\r            index = (indices at: frame) ifTrue: [\r                | duration |\r                name := self writeImageOf: view index: frame - 1 into: directory.\r                duration := frame = indices size\r                    ifTrue: [ secondsPerTick ]\r                    ifFalse: [ ((history at: (indices at: frame + 1)) timeStep - step timeStep) * secondsPerTick ].\r                self writeTimelineImage: name\r                    duration: duration / (rates at: index)\r                    on: timeline.\r                frame := frame + 1 ] ].\r        "La répétition terminale matérialise la durée de la dernière image pour FFmpeg."\r        self writeTimelineImage: name duration: nil on: timeline ].\r    ^ directory\r',
			#category : #replay,
			#selector : #'exportTimedHistory:every:into:rateAt:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'frameReaderFor: aHistory every: stride\r    | history observe nextIndex |\r    history := self checkedHistory: aHistory every: stride.\r    observe := self newStepObserver.\r    nextIndex := 1.\r    ^ [\r        | end view |\r        nextIndex <= history size ifTrue: [\r            end := nextIndex = 1 ifTrue: [ 1 ] ifFalse: [ (nextIndex + stride - 1) min: history size ].\r            nextIndex to: end do: [ :index |\r                view := observe value: (history at: index) ].\r            nextIndex := end + 1 ].\r        view ]\r',
			#category : #replay,
			#selector : #'frameReaderFor:every:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'vercorsFrom: aDirectory\r    | directory |\r    directory := aDirectory asFileReference.\r    ^ self\r        fromTerrain: directory / \'terrain-vercors\'\r        routeFile: directory / \'parcours-vercors.geojson\'\r',
			#category : #'instance creation',
			#selector : #'vercorsFrom:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'on: aScene\r    ^ self new scene: aScene; yourself\r',
			#category : #'instance creation',
			#selector : #'on:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'fromTerrain: aDirectory wayPoints: wayPoints\r    "Les sommets sont ordonnés et exprimés dans le repère d’entrée du terrain."\r    | points |\r    points := wayPoints collect: [ :wayPoint |\r        wayPoint isPoint\r            ifTrue: [ wayPoint ]\r            ifFalse: [ wayPoint longitude @ wayPoint latitude ] ].\r    ^ self on: (PerceptionScene on: aDirectory wayPoints: points)\r',
			#category : #'instance creation',
			#selector : #'fromTerrain:wayPoints:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'fromTerrain: aDirectory routeFile: aFile\r    | geometry features coordinates points |\r    geometry := STONJSON fromString: aFile asFileReference contents.\r    (geometry at: \'type\') = \'FeatureCollection\' ifTrue: [\r        features := geometry at: \'features\'.\r        features size = 1 ifFalse: [ self error: \'Le fichier doit contenir un seul parcours.\' ].\r        geometry := features first ].\r    (geometry at: \'type\') = \'Feature\' ifTrue: [\r        geometry := geometry at: \'geometry\' ].\r    coordinates := (geometry at: \'type\') caseOf: {\r        [ \'Polygon\' ] -> [ (geometry at: \'coordinates\') first ].\r        [ \'LineString\' ] -> [ geometry at: \'coordinates\' ] }\r        otherwise: [ self error: \'Le parcours GeoJSON doit être un Polygon ou un LineString.\' ].\r    points := coordinates collect: [ :pair | pair first @ pair second ].\r    ^ self fromTerrain: aDirectory wayPoints: points\r',
			#category : #'instance creation',
			#selector : #'fromTerrain:routeFile:',
			#className : #PerceptionMacroReplay,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'projectedWayPoints\r    "Les origines des segments de longueur positive, dans l\'ordre du parcours."\r    ^ segments collect: #first as: Array\r',
			#category : #accessing,
			#selector : #projectedWayPoints,
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'observerWith: settings heightAt: heightAt intrudersAt: intrudersAt\r    ^ self observerWith: settings heightAt: heightAt intrudersAt: intrudersAt secondsPerTick: 1\r',
			#category : #observation,
			#selector : #'observerWith:heightAt:intrudersAt:',
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'focusIn: step poses: poses settings: settings secondsPerTick: tickSeconds\r    | id drone pose position condition |\r    id := settings at: #focusDrone ifAbsent: [ nil ].\r    id ifNil: [ ^ nil ].\r    pose := poses detect: [ :each | each id = id ] ifNone: [ nil ].\r    drone := (pose ifNil: [ step lostDrones ] ifNotNil: [ step drones ])\r        detect: [ :each | each id = id ] ifNone: [ nil ].\r    drone ifNil: [ ^ nil ].\r    position := pose ifNil: [ self positionOf: drone in: step ] ifNotNil: [ pose position ].\r    condition := settings at: #focusWhen ifAbsent: [ nil ].\r    (condition notNil and: [ (condition value: step value: position) not ]) ifTrue: [ ^ nil ].\r    ^ {\r        #id -> id.\r        #position -> position.\r        #pose -> pose.\r        #speed -> (pose ifNotNil: [ drone currentSpeed / tickSeconds ]) } asDictionary\r',
			#category : #observation,
			#selector : #'focusIn:poses:settings:secondsPerTick:',
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'terrain\r    ^ terrain\r',
			#category : #accessing,
			#selector : #terrain,
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'perimeterMeters\r    ^ perimeter\r',
			#category : #accessing,
			#selector : #perimeterMeters,
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'observerWith: settings heightAt: heightAt intrudersAt: intrudersAt secondsPerTick: tickSeconds\r    | adapter view lossSeconds visibleLosses knownLosses camera fade\r      measureAcceleration previousSpeeds previousSeconds |\r    (tickSeconds isNumber and: [ tickSeconds asFloat isFinite and: [ tickSeconds > 0 ] ])\r        ifFalse: [ self error: \'La durée d’un tik doit être positive et finie.\' ].\r    lossSeconds := settings at: #lossMarkerSeconds ifAbsent: [ 0 ].\r    (lossSeconds isNumber and: [ lossSeconds >= 0 and: [ lossSeconds asFloat isFinite ] ])\r        ifFalse: [ self error: \'La durée d’affichage d’une perte doit être finie et positive ou nulle.\' ].\r    camera := settings at: #camera ifAbsent: [ #(1.0 2000) ].\r    fade := settings at: #fadeAfterSeconds ifAbsent: [ 300 ].\r    adapter := PerceptionCoverageAdapter on: terrain copy.\r    adapter cameraHalfFieldTangent: camera first sensorSidePixels: camera second.\r    adapter fadeAfterSeconds: fade.\r    (settings at: #transparentAfterSeconds ifAbsent: [ nil ]) ifNotNil: [ :seconds |\r        adapter fadeOutDuration: seconds - fade ].\r    view := PerceptionMissionView on: adapter options: settings.\r    measureAcceleration := view droneColorMode = #acceleration.\r    knownLosses := Set new.\r    visibleLosses := OrderedCollection new.\r    ^ [ :step :seconds |\r        | speeds currentSpeeds poses newLosses positions points |\r        speeds := Dictionary new.\r        currentSpeeds := measureAcceleration ifTrue: [ Dictionary new ].\r        poses := step drones collect: [ :drone |\r            | id speed |\r            id := drone id.\r            speed := drone currentSpeed.\r            drone nominalSpeed > 0 ifTrue: [\r                speeds at: id put: speed / drone nominalSpeed ].\r            measureAcceleration ifTrue: [ currentSpeeds at: id put: speed ].\r            PerceptionDronePose id: id position: (self positionOf: drone in: step)\r                heightAboveGround: (heightAt value: step value: drone) ].\r        newLosses := OrderedCollection new.\r        lossSeconds > 0 ifTrue: [\r            step lostDrones do: [ :drone |\r                (knownLosses includes: drone id) ifFalse: [\r                    newLosses add: { drone id. self positionOf: drone in: step. seconds } ] ] ].\r        positions := (intrudersAt value: step) collect: [ :pair |\r            { pair first. self project: pair second } ].\r        adapter recordAt: seconds polygon: route drones: poses.\r        points := positions collect: [ :pair |\r            | reading |\r            reading := adapter observationAt: pair second.\r            { pair first. pair second. reading notNil and: [ reading first = seconds ] } ].\r        visibleLosses := visibleLosses select: [ :marker | seconds - marker third < lossSeconds ].\r        newLosses do: [ :marker | knownLosses add: marker first. visibleLosses add: marker ].\r        view annotateSpeeds: speeds losses: visibleLosses intruders: points.\r        view annotateFocus: (self focusIn: step poses: poses settings: settings secondsPerTick: tickSeconds).\r        measureAcceleration ifTrue: [\r            | values scale |\r            values := Dictionary new.\r            previousSeconds ifNotNil: [\r                "La vitesse du simulateur est un déplacement par tik."\r                scale := tickSeconds * (seconds - previousSeconds).\r                currentSpeeds keysAndValuesDo: [ :id :speed |\r                    previousSpeeds at: id ifPresent: [ :previous |\r                        values at: id put: (speed - previous) / scale ] ] ].\r            view annotateAccelerations: values.\r            previousSpeeds := currentSpeeds.\r            previousSeconds := seconds ].\r        view ]\r',
			#category : #observation,
			#selector : #'observerWith:heightAt:intrudersAt:secondsPerTick:',
			#className : #PerceptionScene,
			#timeStamp : ''
		},
		MCClassDefinition {
			#name : #PerceptionMissionView,
			#superclassName : #PerceptionRoassalView,
			#variables : OrderedCollection [
				MCInstanceVariableDefinition {
					#name : 'options'
				},
				MCInstanceVariableDefinition {
					#name : 'speedRatios'
				},
				MCInstanceVariableDefinition {
					#name : 'accelerations'
				},
				MCInstanceVariableDefinition {
					#name : 'losses'
				},
				MCInstanceVariableDefinition {
					#name : 'intruders'
				},
				MCInstanceVariableDefinition {
					#name : 'speedRatioLimits'
				},
				MCInstanceVariableDefinition {
					#name : 'movementColors'
				},
				MCInstanceVariableDefinition {
					#name : 'gsdLimits'
				},
				MCInstanceVariableDefinition {
					#name : 'focus'
				},
				MCInstanceVariableDefinition {
					#name : 'focusCells'
				}
			],
			#packageName : #PerceptionMission,
			#type : #normal,
			#comment : 'Options du rejeu pour le fond, les noms, les vitesses et l’affichage des pertes. Les croix restent à la dernière position enregistrée par SoSe pendant lossMarkerSeconds. Un point mobile devient doré au pas où sa cellule est effectivement relevée. detectedIntruderIds répond les identifiants détectés au dernier pas, pour une lecture dans l’exemple ou un moniteur.\r\rshowCoverage commande le dessin des empreintes et des masques du relief. showRoute commande le trait du parcours. droneMarkerSize donne le diamètre des symboles des drones en pixels.\r\rdroneColorMode choisit speed, acceleration ou none. accelerationThreshold donne la demi-largeur de la zone neutre en m/s². En mode accélération, le bleu indique un freinage et l’orange une hausse de vitesse.\r\rshowDrones, showDroneNames, showDroneStatus et showLossMarkers commandent les symboles et leurs étiquettes. movementColors donne les trois couleurs de mouvement. speedRatioLimits fixe les deux seuils relatifs à la vitesse nominale. coverageColors et gsdLimits configurent les cinq teintes de finesse et leurs quatre bornes.\r\rfocusDrone sélectionne un identifiant à incruster. focusWhen reçoit l’état et la position projetée. showFocusFootprint commande le surlignage du champ optique instantané du drone choisi.\r',
			#commentStamp : 'PerceptionMission',
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCClassDefinition {
			#name : #PerceptionFreshnessContract,
			#superclassName : #Object,
			#variables : OrderedCollection [
				MCInstanceVariableDefinition {
					#name : 'zone'
				},
				MCInstanceVariableDefinition {
					#name : 'maximumAgeSeconds'
				},
				MCInstanceVariableDefinition {
					#name : 'minimumFreshRatio'
				},
				MCInstanceVariableDefinition {
					#name : 'startSeconds'
				},
				MCInstanceVariableDefinition {
					#name : 'endSeconds'
				}
			],
			#packageName : #PerceptionMission,
			#type : #normal,
			#comment : 'Exigence de service portant sur une fraction minimale de cases fraîches dans un rectangle projeté. Le calcul repose sur les dates des derniers relevés confirmés. Les centres des cases fixent le périmètre, y compris pour les surfaces NoData. La limite d’âge est exclusive et les bornes de la fenêtre d’activation sont inclusives.\r\rPerceptionMacroReplay>>freshnessContractFor:minimumFreshRatio: reprend le délai de blanc complet pour créer le contrat. Le contrat peut aussi avoir sa propre limite.\r',
			#commentStamp : 'PerceptionMission',
			#tagName : #Replay,
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCClassDefinition {
			#name : #MacroSimulatorFreshnessMetrics,
			#superclassName : #MacroSimulatorMetrics,
			#variables : OrderedCollection [
				MCInstanceVariableDefinition {
					#name : 'freshness'
				}
			],
			#packageName : #PerceptionMission,
			#type : #normal,
			#comment : 'Métriques d’un état macro enrichies de l’acquisition optique et du verdict de fraîcheur. evaluateMetricsOf:freshness: produit un MacroSimulatorMetricsHistory. Utiliser les sélecteurs du rapport dans la liste de champs de MacroSimulatorResultExporter.\r',
			#commentStamp : 'PerceptionMission',
			#tagName : #Replay,
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCClassDefinition {
			#name : #PerceptionMacroReplay,
			#superclassName : #Object,
			#variables : OrderedCollection [
				MCInstanceVariableDefinition {
					#name : 'scene'
				},
				MCInstanceVariableDefinition {
					#name : 'heightAt'
				},
				MCInstanceVariableDefinition {
					#name : 'secondsPerTick'
				},
				MCInstanceVariableDefinition {
					#name : 'displayOptions'
				}
			],
			#packageName : #PerceptionMission,
			#type : #normal,
			#comment : 'Rejoue un historique de MacroSimulator sur un parcours associé à un MNT. La géométrie et l’état des relevés appartiennent à PerceptionScene. Le simulateur reste responsable des drones, des vitesses et des événements.\r\rPour créer une simulation, configurer secondsPerTick avant newSimulatorWith:. Les vitesses de configuration sont en m/s et les distances en mètres. Avancer le simulateur par runSingleUpdate:. Pour un historique existant, secondsPerTick donne la durée simulée d’un tik.\r\rdisplayOptions at: #droneColorMode put: #acceleration donne la couleur d’après l’accélération longitudinale entre deux états successifs de l’historique. Le calcul utilise la durée du tik et se fait à chaque état, quel que soit le pas d’affichage.\r',
			#commentStamp : 'PerceptionMission',
			#tagName : #Replay,
			#traitComposition : '{}',
			#classTraitComposition : '{}'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'nombre: valeur\r\r\t| nombre |\r\tnombre := valeur isNumber\r\t\t          ifTrue: [ valeur asFloat ]\r\t\t          ifFalse: [ Float readFrom: valeur ].\r\tnombre isFinite ifFalse: [ self error: \'Valeur non finie\' ].\r\t^ nombre',
			#category : #systeme,
			#selector : #'nombre:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.251162+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'projeter: points de: source vers: cible\r\r\t| entree lignes |\r\tentree := travail / \'points.txt\'.\r\tentree writeStreamDo: [ :flux |\r\t\t\tpoints do: [ :xy |\r\t\t\t\t\tflux\r\t\t\t\t\t\tnextPutAll: (\' \' join: (xy collect: #asString));\r\t\t\t\t\t\tlf ] ].\r\tlignes := (self\r\t\t           resultat: {\r\t\t\t\t           \'gdaltransform\'.\r\t\t\t\t           \'-s_srs\'.\r\t\t\t\t           source.\r\t\t\t\t           \'-t_srs\'.\r\t\t\t\t           cible }\r\t\t           entree: entree) lines.\r\tlignes size = points size ifFalse: [\r\t\tself error: \'Transformation incomplète\' ].\r\t^ lignes collect: [ :ligne |\r\t\t\t  | champs |\r\t\t\t  champs := ligne substrings.\r\t\t\t  {\r\t\t\t\t  (self nombre: champs first).\r\t\t\t\t  (self nombre: champs second) } ]',
			#category : #coordonnees,
			#selector : #'projeter:de:vers:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.26888+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'json: fichier\r\r\t^ STONJSON fromString: fichier contents',
			#category : #systeme,
			#selector : #'json:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.250556+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'utm: points emprise: bornes\r\r\t| longitude latitude zone |\r\tlongitude := (points collect: #first) sum / points size.\r\tlatitude := (points collect: #second) sum / points size.\r\t(latitude > -80 and: [\r\t\t latitude < 84 and: [ bornes third - bornes first <= 180 ] ])\r\t\tifFalse: [ self error: \'Préciser le CRS métrique avec #crsGrille\' ].\r\tzone := ((longitude + 180 / 6) floor + 1 max: 1) min: 60.\r\t^ \'EPSG:\' , ((latitude >= 0\r\t\t    ifTrue: [ 32600 ]\r\t\t    ifFalse: [ 32700 ]) + zone) asString',
			#category : #coordonnees,
			#selector : #'utm:emprise:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.277067+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'polygone: fichier sortie: dossier options: options\r\r\t| sortie staging |\r\tsortie := dossier asFileReference asAbsolute.\r\tsortie exists ifTrue: [\r\t\tself error: \'Choisir un nouveau dossier de sortie\' ].\r\tsortie parent ensureCreateDirectory.\r\tstaging := sortie parent / (\'.terrain-\' , UUID new asString).\r\tstaging ensureCreateDirectory.\r\t[\r\t\ttravail := staging / \'travail\'.\r\t\ttravail ensureCreateDirectory.\r\t\tself\r\t\t\tproduire: fichier asFileReference\r\t\t\tdans: staging\r\t\t\toptions: options.\r\t\ttravail ensureDeleteAll.\r\t\tsortie exists ifTrue: [\r\t\t\tself error: \'Le dossier de sortie existe déjà\' ].\r\t\tstaging copy renameTo: sortie basename ] ensure: [\r\t\tstaging ensureDeleteAll ].\r\t^ sortie',
			#category : #execution,
			#selector : #'polygone:sortie:options:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.253561+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'quote: valeur\r\r\t| apostrophe |\r\tapostrophe := (Character value: 39) asString.\r\t^ apostrophe , (valeur asString\r\t\t   copyReplaceAll: apostrophe\r\t\t   with:\r\t\t   apostrophe , (Character value: 92) asString , apostrophe\r\t\t   , apostrophe) , apostrophe',
			#category : #systeme,
			#selector : #'quote:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.269385+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'raster: fichier grille: tuile epsg: epsg\r\r\t| warp brut colonnes lignes octets entete |\r\twarp := travail / \'warp.tif\'.\r\tbrut := travail / \'altitudes.bin\'.\r\tcolonnes := tuile fifth.\r\tlignes := tuile sixth.\r\t{\r\t\twarp.\r\t\tbrut.\r\t\t(travail / \'altitudes.hdr\').\r\t\t(travail / \'altitudes.bin.aux.xml\') } do: [ :ref | ref ensureDelete ].\r\tself\r\t\tresultat: {\r\t\t\t\t\'gdalwarp\'.\r\t\t\t\t\'-q\'.\r\t\t\t\t\'-t_srs\'.\r\t\t\t\tepsg.\r\t\t\t\t\'-te\' } , (self bornes: tuile) , {\r\t\t\t\t\'-ts\'.\r\t\t\t\tcolonnes.\r\t\t\t\tlignes.\r\t\t\t\t\'-ot\'.\r\t\t\t\t\'Float32\'.\r\t\t\t\t\'-dstnodata\'.\r\t\t\t\t\'-9999\'.\r\t\t\t\t\'-r\'.\r\t\t\t\t\'bilinear\'.\r\t\t\t\tfichier fullName.\r\t\t\t\twarp fullName }\r\t\tentree: nil.\r\tself\r\t\tresultat: {\r\t\t\t\t\'gdal_translate\'.\r\t\t\t\t\'-q\'.\r\t\t\t\t\'-b\'.\r\t\t\t\t\'1\'.\r\t\t\t\t\'-of\'.\r\t\t\t\t\'ENVI\'.\r\t\t\t\twarp fullName.\r\t\t\t\tbrut fullName }\r\t\tentree: nil.\r\tentete := (travail / \'altitudes.hdr\') contents.\r\t((entete includesSubstring: \'byte order = 0\') and: [\r\t\t entete includesSubstring: \'header offset = 0\' ]) ifFalse: [\r\t\tself error: \'ENVI Float32 little-endian attendu\' ].\r\toctets := brut binaryReadStreamDo: [ :flux | flux upToEnd ].\r\toctets size = (colonnes * lignes * 4) ifFalse: [\r\t\tself error: \'Taille raster inattendue\' ].\r\t^ self\r\t\t  decoder: octets\r\t\t  colonnes: colonnes\r\t\t  lignes: lignes\r\t\t  ign: false',
			#category : #raster,
			#selector : #'raster:grille:epsg:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.270821+01:00'
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'shell: commande\r    "Les outils GDAL utilisent les bibliothèques du système."\r    ^ LibC system: \'/usr/bin/env -u LD_LIBRARY_PATH -u DYLD_LIBRARY_PATH \', commande\r',
			#category : #systeme,
			#selector : #'shell:',
			#className : #PreparerTerrain,
			#timeStamp : ''
		},
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'epsgMetrique: description\r\r\t| id axes |\r\t(description at: \'type\') = \'ProjectedCRS\' ifFalse: [ ^ nil ].\r\tid := description at: \'id\' ifAbsent: [ ^ nil ].\r\t(id at: \'authority\') = \'EPSG\' ifFalse: [ ^ nil ].\r\taxes := (description at: \'coordinate_system\') at: \'axis\'.\r\t(axes size >= 2 and: [\r\t\t\t (axes first at: \'unit\') = \'metre\' and: [\r\t\t\t\t (axes second at: \'unit\') = \'metre\' ] ]) ifFalse: [ ^ nil ].\r\t^ \'EPSG:\' , (id at: \'code\') asString',
			#category : #coordonnees,
			#selector : #'epsgMetrique:',
			#className : #PreparerTerrain,
			#timeStamp : '2026-11-24T17:03:20.248314+01:00'
		},
