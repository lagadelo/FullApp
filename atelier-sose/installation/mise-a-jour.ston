				#source : 'drawLegend\r    | y muted coverage mode |\r    coverage := self showsCoverage.\r    coverage\r        ifTrue: [ super drawLegend ]\r        ifFalse: [\r            self\r                label: \'Temps simulé  \', ((adapter time ifNil: [ 0 ]) printShowingDecimalPlaces: 2), \' s\'\r                at: 16 @ 10\r                size: 18\r                color: Color white ].\r    y := canvas extent y - 49.\r    muted := Color fromHexString: \'C0CEE0\'.\r    mode := self droneColorMode.\r    mode = #none ifFalse: [\r        | labels |\r        labels := mode = #acceleration\r            ifTrue: [ #( \'Accélération\' \'Freine\' \'Stable\' \'Accélère\' ) ]\r            ifFalse: [ #( \'Vitesse\' \'Lente\' \'Nominale\' \'Rapide\' ) ].\r        self label: labels first at: 445 @ y size: 13 color: muted.\r        self label: labels second at: 552 @ y size: 13 color: (Color fromHexString: \'62C6FF\').\r        self label: labels third at: 614 @ y size: 13 color: Color white.\r        self label: labels fourth at: 697 @ y size: 13 color: (Color fromHexString: \'FFAE68\') ].\r    coverage ifTrue: [\r        self label: \'Hachures · masque\' at: 777 @ y size: 13\r            color: (Color fromHexString: \'F879A7\').\r        adapter transparentAfterSeconds ifNotNil: [ :seconds |\r            self label: \'Transparent à \', seconds printString, \' s\'\r                at: 270 @ (y + 21) size: 13 color: muted ] ].\r    (options at: #lossMarkerSeconds ifAbsent: [ 0 ]) > 0 ifTrue: [\r        self label: \'Croix rouge · perte\' at: 460 @ (y + 21)\r            size: 13 color: (Color fromHexString: \'FF706B\') ].\r    intruders ifNotEmpty: [\r        self label: \'Point doré · détecté\' at: 760 @ (y + 21)\r            size: 13 color: (Color fromHexString: \'FFE48F\') ]\r',
