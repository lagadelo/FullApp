		] : OrderedCollection [
			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'tuile: tuile fournisseur: source epsg: epsg\r\t| bbox colonnes lignes fichier octets numero |\r\tbbox := \',\' join: ((self bornes: tuile) collect: #asString).\r\tcolonnes := tuile fifth. lignes := tuile sixth.\r\tsource = \'ign\' ifTrue: [\r\t\tfichier := self telecharger: \'https://data.geopf.fr/wms-r/wms\' parametres: {\r\t\t\t\'SERVICE\' -> \'WMS\'. \'VERSION\' -> \'1.3.0\'. \'REQUEST\' -> \'GetMap\'.\r\t\t\t\'CRS\' -> epsg. \'BBOX\' -> bbox. \'WIDTH\' -> colonnes. \'HEIGHT\' -> lignes.\r\t\t\t\'LAYERS\' -> \'ELEVATION.ELEVATIONGRIDCOVERAGE.HIGHRES\'. \'STYLES\' -> \'normal\'.\r\t\t\t\'FORMAT\' -> \'image/x-bil;bits=32\'} asDictionary.\r\t\toctets := fichier binaryReadStreamDo: [:flux | flux upToEnd].\r\t\toctets size = (colonnes * lignes * 4) ifFalse: [self error: \'Réponse BIL IGN inattendue\'].\r\t\t^ self decoder: octets colonnes: colonnes lignes: lignes ign: true].\r\tnumero := epsg allButFirst: 5.\r\tfichier := self telecharger: \'https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer/exportImage\'\r\t\tparametres: {\'bbox\' -> bbox. \'bboxSR\' -> numero. \'imageSR\' -> numero.\r\t\t\t\'size\' -> (colonnes asString , \',\' , lignes asString). \'format\' -> \'tiff\'.\r\t\t\t\'pixelType\' -> \'F32\'. \'adjustAspectRatio\' -> \'false\'. \'f\' -> \'image\'} asDictionary.\r\t^ self raster: fichier grille: tuile epsg: epsg\r',
				#category : #raster,
				#selector : #'tuile:fournisseur:epsg:',
				#className : #PreparerTerrain,
				#timeStamp : '2026-11-24T17:03:19.578799+01:00'
			}
