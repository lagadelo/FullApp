					MCInstanceVariableDefinition {
						#name : 'displayOptions'
					}
				],
				#packageName : #PerceptionMission,
				#type : #normal,
				#comment : 'Rejoue un historique de MacroSimulator sur un parcours associé à un MNT. La géométrie et l’état des relevés appartiennent à PerceptionScene. Le simulateur reste responsable des drones, des vitesses et des événements.\r\rPour créer une simulation, configurer secondsPerTick avant newSimulatorWith:. Les vitesses de configuration sont en m/s et les distances en mètres. Avancer le simulateur par runSingleUpdate:. Pour un historique existant, secondsPerTick donne la durée simulée d’un tik.\r\rdisplayOptions at: #droneColorMode put: #acceleration donne la couleur d’après l’accélération longitudinale entre deux états successifs de l’historique. Le calcul utilise la durée du tik et se fait à chaque état, quel que soit le pas d’affichage.\r',
				#commentStamp : 'PerceptionMission',
				#tagName : #Replay,
				#traitComposition : '{}',
				#classTraitComposition : '{}'
			}
		],
		[
			#PerceptionScene,
			#'observerWith:heightAt:intrudersAt:secondsPerTick:',
			false
		] : OrderedCollection [
			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'observerWith: settings heightAt: heightAt intrudersAt: intrudersAt secondsPerTick: tickSeconds\r    | adapter view lossSeconds visibleLosses knownLosses camera fade\r      measureAcceleration previousSpeeds previousSeconds |\r    (tickSeconds isNumber and: [ tickSeconds asFloat isFinite and: [ tickSeconds > 0 ] ])\r        ifFalse: [ self error: \'La durée d’un tik doit être positive et finie.\' ].\r    lossSeconds := settings at: #lossMarkerSeconds ifAbsent: [ 0 ].\r    (lossSeconds isNumber and: [ lossSeconds >= 0 and: [ lossSeconds asFloat isFinite ] ])\r        ifFalse: [ self error: \'La durée d’affichage d’une perte doit être finie et positive ou nulle.\' ].\r    camera := settings at: #camera ifAbsent: [ #(1.0 2000) ].\r    fade := settings at: #fadeAfterSeconds ifAbsent: [ 300 ].\r    adapter := PerceptionCoverageAdapter on: terrain copy.\r    adapter cameraHalfFieldTangent: camera first sensorSidePixels: camera second.\r    adapter fadeAfterSeconds: fade.\r    (settings at: #transparentAfterSeconds ifAbsent: [ nil ]) ifNotNil: [ :seconds |\r        adapter fadeOutDuration: seconds - fade ].\r    view := PerceptionMissionView on: adapter options: settings.\r    measureAcceleration := view droneColorMode = #acceleration.\r    knownLosses := Set new.\r    visibleLosses := OrderedCollection new.\r    ^ [ :step :seconds |\r        | speeds currentSpeeds poses newLosses positions points |\r        speeds := Dictionary new.\r        currentSpeeds := measureAcceleration ifTrue: [ Dictionary new ].\r        poses := step drones collect: [ :drone |\r            | id speed |\r            id := drone id.\r            speed := drone currentSpeed.\r            drone nominalSpeed > 0 ifTrue: [\r                speeds at: id put: speed / drone nominalSpeed ].\r            measureAcceleration ifTrue: [ currentSpeeds at: id put: speed ].\r            PerceptionDronePose id: id position: (self positionOf: drone in: step)\r                heightAboveGround: (heightAt value: step value: drone) ].\r        newLosses := OrderedCollection new.\r        lossSeconds > 0 ifTrue: [\r            step lostDrones do: [ :drone |\r                (knownLosses includes: drone id) ifFalse: [\r                    newLosses add: { drone id. self positionOf: drone in: step. seconds } ] ] ].\r        positions := (intrudersAt value: step) collect: [ :pair |\r            { pair first. self project: pair second } ].\r        adapter recordAt: seconds polygon: route drones: poses.\r        points := positions collect: [ :pair |\r            | reading |\r            reading := adapter observationAt: pair second.\r            { pair first. pair second. reading notNil and: [ reading first = seconds ] } ].\r        visibleLosses := visibleLosses select: [ :marker | seconds - marker third < lossSeconds ].\r        newLosses do: [ :marker | knownLosses add: marker first. visibleLosses add: marker ].\r        view annotateSpeeds: speeds losses: visibleLosses intruders: points.\r        measureAcceleration ifTrue: [\r            | values scale |\r            values := Dictionary new.\r            previousSeconds ifNotNil: [\r                "La vitesse du simulateur est un déplacement par tik."\r                scale := tickSeconds * (seconds - previousSeconds).\r                currentSpeeds keysAndValuesDo: [ :id :speed |\r                    previousSpeeds at: id ifPresent: [ :previous |\r                        values at: id put: (speed - previous) / scale ] ] ].\r            view annotateAccelerations: values.\r            previousSpeeds := currentSpeeds.\r            previousSeconds := seconds ].\r        view ]\r',
				#category : #observation,
				#selector : #'observerWith:heightAt:intrudersAt:secondsPerTick:',
				#className : #PerceptionScene,
				#timeStamp : ''
			}
		],
