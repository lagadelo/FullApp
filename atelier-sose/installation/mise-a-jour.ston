			MCMethodDefinition {
				#classIsMeta : false,
				#source : 'polygone: fichier\r\r\t| objet crs sommets type |\r\tobjet := self json: fichier.\r\tcrs := self crsDeclare: objet.\r\tobjet isDictionary ifTrue: [\r\t\t\ttype := objet at: \'type\'.\r\t\t\ttype = \'FeatureCollection\' ifTrue: [\r\t\t\t\t\tsommets := objet at: \'features\'.\r\t\t\t\t\tsommets size = 1 ifFalse: [\r\t\t\t\t\t\tself error: \'Un seul polygone est attendu\' ].\r\t\t\t\t\tobjet := sommets first.\r\t\t\t\t\tcrs := (self crsDeclare: objet) ifNil: [ crs ] ].\r\t\t\t(objet at: \'type\') = \'Feature\' ifTrue: [\r\t\t\t\t\tobjet := objet at: \'geometry\'.\r\t\t\t\t\tcrs := (self crsDeclare: objet) ifNil: [ crs ] ].\r\t\t\t(objet at: \'type\') = \'Polygon\' ifFalse: [\r\t\t\t\tself error: \'Un Polygon est attendu\' ].\r\t\t\tobjet := (objet at: \'coordinates\') first ].\r\tsommets := objet collect: [ :xy |\r\t\t\t           {\r\t\t\t\t           (self nombre: xy first).\r\t\t\t\t           (self nombre: xy second) } ].\r\t(sommets notEmpty and: [ sommets first = sommets last ]) ifTrue: [\r\t\tsommets := sommets allButLast ].\r\tsommets asSet size < 3 ifTrue: [\r\t\tself error: \'Trois sommets distincts sont requis\' ].\r\t^ {\r\t\t  sommets.\r\t\t  crs }',
				#category : #coordonnees,
				#selector : #'polygone:',
