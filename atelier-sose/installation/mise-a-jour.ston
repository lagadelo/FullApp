				#source : 'commande: arguments entree: entree sortie: sortie\r\r\t| texte erreur statut |\r\terreur := travail / \'erreur.txt\'.\r\ttexte := \'PATH=/opt/homebrew/bin:/usr/local/bin:$PATH LC_ALL=C \'\r\t         ,\r\t         (\' \' join: (arguments collect: [ :arg | self quote: arg ])).\r\tentree ifNotNil: [\r\t\ttexte := texte , \' < \' , (self quote: entree fullName) ].\r\ttexte := texte , \' > \' , (self quote: sortie fullName) , \' 2> \'\r\t         , (self quote: erreur fullName).\r\tstatut := self shell: texte.\r\tstatut = 0 ifFalse: [\r\t\tself error: arguments first , \' a échoué. \' , erreur contents ]',
				#category : #systeme,
