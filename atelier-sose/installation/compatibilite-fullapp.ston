	] : [
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'heightAboveGround: metres\r\r\t(metres isNumber and: [ metres asFloat isFinite and: [ metres > 0 ] ])\r\t\tifFalse: [\r\t\t\tself error:\r\t\t\t\t\'La hauteur au-dessus du sol doit être positive et finie.\' ].\r\tself heightAt: [ :step :drone | metres ]',
			#category : #configuration,
			#selector : #'heightAboveGround:',
