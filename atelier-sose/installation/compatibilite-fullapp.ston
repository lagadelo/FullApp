			#className : #PerceptionMacroReplay,
			#timeStamp : '2026-11-24T19:44:58.074241+01:00'
		}
	],
	[
		#PerceptionMacroReplay,
		#'playHistory:every:',
		false
	] : [
		MCMethodDefinition {
			#classIsMeta : false,
			#source : 'playHistory: aHistory every: stride\r\r\t| nextFrame view animation lastFrame window extent |\r\tnextFrame := self frameReaderFor: aHistory every: stride.\r\tview := nextFrame value.\r\textent := view canvas extent + (20 @ 40).\r\tlastFrame := Time millisecondClockValue.\r\tanimation := view canvas newAnimation.\r\tanimation\r\t\trepeat;\r\t\tonStepDo: [\r\t\t\t\t(Time millisecondsSince: lastFrame) >= 80 ifTrue: [\r\t\t\t\t\t\t\tnextFrame value\r\t\t\t\t\t\t\t\tifNil: [ animation stop ]\r\t\t\t\t\t\t\t\tifNotNil: [ :nextView | nextView refresh ].\r\t\t\t\t\t\t\tlastFrame := Time millisecondClockValue ] ].\r\twindow := view open.\r\twindow extent: extent.\r\t^ window',
			#category : #replay,
			#selector : #'playHistory:every:',
			#className : #PerceptionMacroReplay,
			#timeStamp : '2026-11-24T19:44:58.08082+01:00'
		}
	],
	[
		#PerceptionMacroReplay,
		#'fromTerrain:wayPoints:',
		true
	] : [
		MCMethodDefinition {
			#classIsMeta : true,
			#source : 'fromTerrain: aDirectory wayPoints: wayPoints\r\t"Les sommets sont ordonnés et exprimés dans le repère d’entrée du terrain."\r\r\t| points |\r\tpoints := wayPoints collect: [ :wayPoint |\r\t\t\t          wayPoint isPoint\r\t\t\t\t          ifTrue: [ wayPoint ]\r\t\t\t\t          ifFalse: [ wayPoint longitude @ wayPoint latitude ] ].\r\t^ self on: (PerceptionScene on: aDirectory wayPoints: points)',
			#category : #'instance creation',
			#selector : #'fromTerrain:wayPoints:',
			#className : #PerceptionMacroReplay,
			#timeStamp : '2026-11-24T19:44:58.073377+01:00'
		}
