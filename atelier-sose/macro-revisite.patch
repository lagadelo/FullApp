--- /dev/null
+++ b/src/DroneSystem-Macro/MacroSimulatorSelectablePerception.class.st
@@ -0,0 +1,36 @@
+"
+A single observation hypothesis on a georeferenced path. Range and sensor outage
+flags are still evaluated by the hybrid perception model.
+"
+Class {
+	#name : 'MacroSimulatorSelectablePerception',
+	#superclass : 'MacroSimulatorHybridPerception',
+	#instVars : [ 'mode' ],
+	#category : 'DroneSystem-Macro'
+}
+
+{ #category : 'instance creation' }
+MacroSimulatorSelectablePerception class >> mode: selector [
+	^ self new initializeMode: selector
+]
+
+{ #category : 'initialization' }
+MacroSimulatorSelectablePerception >> initializeMode: selector [
+	(#(distance bearing) includes: selector) ifFalse: [ self error: 'Hypothèse de perception inconnue.' ].
+	mode := selector
+]
+
+{ #category : 'accessing' }
+MacroSimulatorSelectablePerception >> mode [
+	^ mode
+]
+
+{ #category : 'observing' }
+MacroSimulatorSelectablePerception >> allowsDistanceFor: drone [
+	^ mode = #distance and: [ super allowsDistanceFor: drone ]
+]
+
+{ #category : 'observing' }
+MacroSimulatorSelectablePerception >> allowsBearingFor: drone [
+	^ mode = #bearing and: [ super allowsBearingFor: drone ]
+]
